{
  "name": "attach-cli",
  "author": "AnalogDevices",
  "description": "CLI tool for configuring Linux device tree overlays",
  "license": "Apache-2.0",
  "type": "module",
  "version": "0.1.0",
  "files": [
    "dist",
    "scripts",
    "bundled",
    "SKILL.md"
  ],
  "bin": {
    "attach": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "tsc -p src/tsconfig.json",
    "build": "tsup --silent --dts",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "npm run build",
    "dev-link": "yarn build && mkdir -p $HOME/.local/bin && ln -sf \"$(pwd)/dist/cli.js\" $HOME/.local/bin/attach && chmod +x dist/cli.js && echo 'attach linked to $HOME/.local/bin/attach'",
    "clean": "rm -rf dist tsconfig.tsbuildinfo node_modules",
    "lint": "eslint src",
    "format": "eslint . --fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage"
  },
  "tsup": {
    "entry": [
      "src/bin/cli.ts"
    ],
    "format": [
      "esm"
    ],
    "tsconfig": "src/tsconfig.json",
    "clean": true,
    "splitting": true,
    "minify": true,
    "noExternal": [
      "attach-lib"
    ],
    "external": [
      "yaml"
    ]
  },
  "dependencies": {
    "@stricli/core": "^1.2.6",
    "smol-toml": "^1.7.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "25.x",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vitest/coverage-v8": "^4.0.18",
    "attach-lib": "*",
    "eslint": "^9.31.0",
    "eslint-plugin-unicorn": "^60.0.0",
    "tsup": "^6.7.0",
    "typescript": "5.6.x",
    "vitest": "^4.0.18"
  }
}
