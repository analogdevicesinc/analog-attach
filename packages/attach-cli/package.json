{
  "name": "attach-linux",
  "author": "AnalogDevices",
  "description": "Configure Linux device tree overlays for peripherals",
  "license": "Apache-2.0",
  "type": "module",
  "version": "0.1.0",
  "files": [
    "dist",
    "scripts",
    "bundled",
    "SKILL.md"
  ],
  "bin": "dist/cli.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "scripts/bundle-dt-schema.sh && tsc -p src/tsconfig.json && tsup --silent",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "npm run build",
    "dev-link": "yarn build && mkdir -p $HOME/.local/bin && ln -sf \"$(pwd)/dist/cli.js\" $HOME/.local/bin/attach-linux && chmod +x dist/cli.js && echo 'attach-linux linked to $HOME/.local/bin/attach-linux'",
    "clean": "rm -rf dist tsconfig.tsbuildinfo node_modules",
    "lint": "eslint src",
    "format": "eslint . --fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage",
    "corpus": "node scripts/corpus.mjs run",
    "corpus:diff": "node scripts/corpus.mjs diff"
  },
  "tsup": {
    "entry": [
      "src/bin/cli.ts"
    ],
    "format": [
      "esm"
    ],
    "tsconfig": "src/tsconfig.json",
    "dts": {
      "compilerOptions": {
        "ignoreDeprecations": "6.0"
      }
    },
    "clean": true,
    "loader": {
      ".html": "text"
    },
    "splitting": true,
    "minify": true,
    "noExternal": [
      "attach-lib"
    ],
    "external": [
      "yaml"
    ]
  },
  "dependencies": {
    "commander": "^13.1.0",
    "smol-toml": "^1.7.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "25.x",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^4.0.18",
    "attach-lib": "*",
    "eslint": "^9.31.0",
    "eslint-plugin-unicorn": "^60.0.0",
    "tsup": "^6.7.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.18"
  }
}
