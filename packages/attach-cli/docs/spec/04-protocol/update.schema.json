{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "update.schema.json",
  "title": "update response",
  "description": "Standard output of update in JSON mode: a value or flag set (UPDATE-100), a read (UPDATE-112), an existing child node (UPDATE-120), a created child node (UPDATE-125), or a refusal (COM-040).",
  "oneOf": [
    { "$ref": "#/$defs/set" },
    { "$ref": "#/$defs/read-property" },
    { "$ref": "#/$defs/node" },
    { "$ref": "#/$defs/child-created" },
    { "$ref": "common.schema.json#/$defs/refusal" }
  ],
  "$defs": {
    "set": {
      "type": "object",
      "required": ["ok", "message", "severity"],
      "properties": {
        "ok": { "const": true },
        "message": {
          "type": "string",
          "description": "Set <property> on <path>[; renamed to <key>][; <interrupt-parent detail>], or Set flag <property> on <path>.",
          "pattern": "^Set (flag )?"
        },
        "severity": { "enum": ["info", "warn"], "description": "warn when a warning of UPDATE-040, UPDATE-075, UPDATE-082 or UPDATE-083 was given (UPDATE-100); the diagnostics of UPDATE-015, UPDATE-073 and UPDATE-074 leave it info." }
      },
      "additionalProperties": false
    },
    "child-created": {
      "type": "object",
      "required": ["ok", "message", "severity", "path", "missing_required"],
      "properties": {
        "ok": { "const": true },
        "message": { "type": "string", "pattern": "^Added .+ to .+$" },
        "severity": { "const": "info" },
        "path": { "$ref": "common.schema.json#/$defs/node-path" },
        "missing_required": {
          "type": "array",
          "items": { "$ref": "add.schema.json#/$defs/missing-property" }
        }
      },
      "additionalProperties": false
    },
    "read-property": {
      "description": "The property as the merged tree has it, with where its value is set and what the binding says (read's property response).",
      "type": "object",
      "required": ["kind", "key", "type", "value", "source"],
      "properties": {
        "kind": { "const": "property" },
        "key": { "type": "string" },
        "type": { "$ref": "#/$defs/types" },
        "value": { "$ref": "#/$defs/property-value" },
        "source": { "enum": ["base", "overlay"] },
        "description": { "type": "string" },
        "suggestions": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/suggestion" }
        }
      },
      "additionalProperties": false
    },
    "node": {
      "description": "An existing child, as read <path>/<child> gives it (UPDATE-120): read's merged node, with missing_required unless --quiet.",
      "$ref": "read.schema.json#/$defs/read-node"
    },
    "property-value": {
      "description": "A flag is true; a cell is a number, a reference the string &label; several values are an array.",
      "anyOf": [
        { "type": "null" },
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "array", "items": { "$ref": "#/$defs/property-value" } }
      ]
    },
    "types": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "subtype"],
          "properties": { "kind": { "const": "number" }, "subtype": { "enum": ["int", "float"] } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "enum": ["string", "bool"] } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "options"],
          "properties": {
            "kind": { "const": "enum" },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["value"],
                "properties": {
                  "value": { "anyOf": [{ "type": "string" }, { "type": "number" }] },
                  "display_string": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "items"],
          "properties": {
            "kind": { "const": "array" },
            "items": { "$ref": "#/$defs/types" },
            "min_items": { "type": "integer", "minimum": 0 },
            "max_items": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "items"],
          "properties": {
            "kind": { "const": "tuple" },
            "items": { "type": "array", "items": { "$ref": "#/$defs/types" } }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
