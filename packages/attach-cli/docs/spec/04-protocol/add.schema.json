{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "add.schema.json",
  "title": "add response",
  "description": "Standard output of add in JSON mode (ADD-100): the added node, or a refusal.",
  "oneOf": [
    { "$ref": "#/$defs/added" },
    { "$ref": "common.schema.json#/$defs/refusal" }
  ],
  "$defs": {
    "added": {
      "type": "object",
      "required": ["ok", "message", "severity", "key", "path", "template", "missing_required"],
      "properties": {
        "ok": { "const": true },
        "message": {
          "type": "string",
          "description": "Added <key> (label: <label>)."
        },
        "severity": { "const": "info" },
        "key": { "type": "string", "description": "The new node's name with its unit address." },
        "path": { "$ref": "common.schema.json#/$defs/node-path" },
        "template": {
          "type": "string",
          "pattern": "^(required|example:[1-9][0-9]*|overlay:.+)$"
        },
        "missing_required": {
          "description": "The required properties the node lacks, in the order to set them (11).",
          "type": "array",
          "items": { "$ref": "#/$defs/missing-property" }
        },
        "unresolved": {
          "description": "Copy templates only: references in the new node that name no node of the merged tree (ADD-091).",
          "type": "array",
          "items": { "$ref": "#/$defs/unresolved-entry" }
        }
      },
      "additionalProperties": false,
      "if": { "properties": { "template": { "const": "required" } } },
      "then": { "not": { "required": ["unresolved"] } },
      "else": { "required": ["unresolved"] }
    },
    "missing-property": {
      "type": "object",
      "required": ["property", "suggestions"],
      "properties": {
        "property": { "type": "string" },
        "description": { "type": "string", "description": "The binding's description." },
        "suggestions": {
          "description": "list value's values (which may carry a note from the binding, e.g. a required flag's explanation), then the other candidates, each marked by its note: disabled, enabled, enabled by the overlay (ADD-110).",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/suggestion" }
        }
      },
      "additionalProperties": false
    },
    "unresolved-entry": {
      "type": "object",
      "required": ["path", "property", "reference"],
      "properties": {
        "path": { "$ref": "common.schema.json#/$defs/node-path" },
        "property": { "type": "string" },
        "reference": { "type": "string", "pattern": "^&", "description": "As written: &label or &{/path}." }
      },
      "additionalProperties": false
    }
  }
}
