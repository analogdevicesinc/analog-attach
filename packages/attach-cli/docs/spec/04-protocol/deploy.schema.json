{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deploy.schema.json",
  "title": "deploy response",
  "description": "Standard output of deploy in JSON mode (DEPLOY-011, DEPLOY-022).",
  "oneOf": [
    {
      "type": "object",
      "required": ["ok", "message", "severity", "host", "remote_path"],
      "properties": {
        "ok": { "const": true },
        "message": { "const": "Deployed and rebooted" },
        "severity": { "const": "info" },
        "host": { "type": "string", "description": "deploy-ip as configured." },
        "remote_path": { "const": "/boot/overlays/" }
      },
      "additionalProperties": false
    },
    {
      "$ref": "common.schema.json#/$defs/refusal",
      "description": "The copy failed: message is 'scp failed: ' and the command's standard error."
    }
  ]
}
