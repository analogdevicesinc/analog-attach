{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "read.schema.json",
  "title": "read response",
  "description": "Standard output of read in JSON mode: the overlay (READ-011), a node (READ-024), a property (READ-035), or a refusal.",
  "oneOf": [
    {
      "$ref": "#/$defs/overlay"
    },
    {
      "$ref": "#/$defs/read-node"
    },
    {
      "$ref": "#/$defs/read-property"
    },
    {
      "$ref": "common.schema.json#/$defs/refusal"
    }
  ],
  "$defs": {
    "types": {
      "description": "A value's type. read infers it from the value (READ-050); list property gives the binding's.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "subtype"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "subtype": {
              "enum": [
                "int",
                "float"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "string",
                "bool"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "options"
          ],
          "properties": {
            "kind": {
              "const": "enum"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "display_string": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "$ref": "#/$defs/types"
            },
            "min_items": {
              "type": "integer",
              "minimum": 0
            },
            "max_items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "tuple"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/types"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "value": {
      "description": "A property value (READ-050): null, a string (&label for a reference), a number, true for a flag, or an array of these.",
      "type": [
        "null",
        "string",
        "number",
        "boolean",
        "array"
      ],
      "items": {
        "$ref": "#/$defs/value"
      }
    },
    "source": {
      "enum": [
        "base",
        "overlay"
      ]
    },
    "property": {
      "type": "object",
      "required": [
        "kind",
        "key",
        "type",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "property"
        },
        "key": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/types"
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      }
    },
    "node": {
      "description": "A node of the overlay file as written (READ-051).",
      "type": "object",
      "required": [
        "kind",
        "key",
        "properties",
        "children",
        "alias"
      ],
      "properties": {
        "kind": {
          "const": "node"
        },
        "key": {
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "allOf": [
              {
                "$ref": "#/$defs/property"
              }
            ],
            "unevaluatedProperties": false
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "alias": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "overlay": {
      "description": "read without a path (READ-011): the nodes of every __overlay__ body, under a root with no properties.",
      "type": "object",
      "required": [
        "kind",
        "key",
        "properties",
        "children"
      ],
      "properties": {
        "kind": {
          "const": "node"
        },
        "key": {
          "const": "/"
        },
        "properties": {
          "type": "array",
          "maxItems": 0
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "additionalProperties": false
    },
    "read-property-entry": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/property"
        }
      ],
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "unevaluatedProperties": false
    },
    "read-node": {
      "description": "A merged node (READ-022, READ-052). A collapsed child has origin base and no properties or children.",
      "type": "object",
      "required": [
        "kind",
        "key",
        "properties",
        "children",
        "alias",
        "origin"
      ],
      "properties": {
        "kind": {
          "const": "node"
        },
        "key": {
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/read-property-entry"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/read-node"
          }
        },
        "alias": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "origin": {
          "enum": [
            "base",
            "overlay",
            "both"
          ]
        }
      },
      "additionalProperties": false
    },
    "read-property": {
      "type": "object",
      "description": "One property of a merged node (READ-035).",
      "allOf": [
        {
          "$ref": "#/$defs/property"
        }
      ],
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "description": {
          "type": "string",
          "description": "The binding's description."
        },
        "suggestions": {
          "$ref": "#/$defs/read-suggestions"
        }
      },
      "unevaluatedProperties": false
    },
    "read-suggestions": {
      "description": "READ-035: the suggested values, and the providers the user can add instead (READ-036).",
      "type": "object",
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/suggestion"
          }
        },
        "can_create": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/suggestion"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
