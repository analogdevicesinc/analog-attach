{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delete.schema.json",
  "title": "delete response",
  "description": "Standard output of delete in JSON mode: a preview (DELETE-012, DELETE-024), a success (DELETE-013, DELETE-027, DELETE-032), or a refusal.",
  "oneOf": [
    { "$ref": "#/$defs/preview" },
    { "$ref": "#/$defs/done" },
    { "$ref": "common.schema.json#/$defs/refusal" }
  ],
  "$defs": {
    "preview": {
      "description": "What the delete would remove; nothing was removed.",
      "type": "object",
      "required": ["ok", "message", "severity", "node_count", "property_count", "paths"],
      "properties": {
        "ok": { "const": true },
        "message": { "type": "string", "pattern": "^Would delete [0-9]+ node\\(s\\) and [0-9]+ property\\(ies\\)$" },
        "severity": { "const": "warn" },
        "node_count": { "type": "integer", "minimum": 0 },
        "property_count": { "type": "integer", "minimum": 0 },
        "paths": {
          "description": "The counted nodes, as segments from the fragment's target (no path) or from the deleted node (with a path).",
          "type": "array",
          "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      },
      "additionalProperties": false
    },
    "done": {
      "type": "object",
      "required": ["ok", "message", "severity"],
      "properties": {
        "ok": { "const": true },
        "message": { "type": "string" },
        "severity": { "const": "info" }
      },
      "additionalProperties": false
    }
  }
}
