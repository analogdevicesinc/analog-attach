{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "list.schema.json",
  "title": "list and __list responses",
  "description": "Standard output of list and __list in JSON mode. Which shape a kind gives is in 03-commands/list.md and __list.md; any kind can also refuse.",
  "anyOf": [
    {
      "$ref": "#/$defs/kinds"
    },
    {
      "$ref": "#/$defs/names-response"
    },
    {
      "$ref": "#/$defs/device-response"
    },
    {
      "$ref": "#/$defs/suggestions-response"
    },
    {
      "$ref": "#/$defs/type-response"
    },
    {
      "$ref": "#/$defs/overlay-response"
    },
    {
      "$ref": "common.schema.json#/$defs/refusal"
    }
  ],
  "$defs": {
    "kinds": {
      "description": "list without a kind (LIST-001).",
      "type": "object",
      "required": [
        "ok",
        "message",
        "severity",
        "intelligence"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "const": "info"
        },
        "intelligence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "description",
              "args"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "devices",
                  "property",
                  "value",
                  "parent",
                  "overlay"
                ]
              },
              "description": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "description",
                    "required"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "kind": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "names-response": {
      "description": "list devices without an exact match (LIST-011).",
      "type": "object",
      "required": [
        "ok",
        "message",
        "severity",
        "names"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "const": "info"
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "device-response": {
      "description": "list devices <compatible> (LIST-013).",
      "type": "object",
      "required": [
        "ok",
        "message",
        "severity",
        "device"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "const": "info"
        },
        "device": {
          "type": "object",
          "required": [
            "compatible",
            "binding",
            "properties",
            "children"
          ],
          "properties": {
            "compatible": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "binding": {
              "type": "string",
              "description": "The binding file, absolute."
            },
            "properties": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/property-description"
              }
            },
            "children": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "pattern",
                  "name",
                  "properties"
                ],
                "properties": {
                  "pattern": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string",
                    "description": "The pattern's literal start, with N when it ends in @ (channel@N, fan-), or the pattern itself (LIST-013)."
                  },
                  "description": {
                    "type": "string"
                  },
                  "properties": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/property-description"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "property-description": {
      "type": "object",
      "required": [
        "name",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "object",
          "required": [
            "type",
            "display"
          ],
          "properties": {
            "type": {
              "$ref": "#/$defs/types"
            },
            "display": {
              "type": "string"
            },
            "min_items": {
              "type": "integer"
            },
            "max_items": {
              "type": "integer"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "default": {
              "$ref": "#/$defs/property-value"
            },
            "const": {
              "$ref": "#/$defs/property-value"
            }
          },
          "additionalProperties": false
        },
        "required": {
          "type": "boolean"
        },
        "set": {
          "type": "boolean"
        },
        "suggestions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/suggestion"
          }
        }
      },
      "additionalProperties": false
    },
    "suggestions-response": {
      "description": "list property <path>, list value, list parent and every __list kind but type (LIST-036, LIST-077, LIST-092, INTLIST-003). list parent with an unknown compatible has severity warn (LIST-090).",
      "type": "object",
      "required": [
        "ok",
        "message",
        "severity",
        "suggestions"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warn"
          ]
        },
        "suggestions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/suggestion"
          }
        }
      },
      "additionalProperties": false
    },
    "type-response": {
      "description": "list property <path> <property> and __list type (LIST-054).",
      "type": "object",
      "required": [
        "ok",
        "message",
        "severity",
        "type"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "const": "info"
        },
        "type": {
          "$ref": "#/$defs/types"
        },
        "description": {
          "type": "string"
        },
        "suggestions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/suggestion"
          }
        }
      },
      "additionalProperties": false
    },
    "overlay-response": {
      "description": "list overlay (LIST-114), in LIST-113's order.",
      "type": "object",
      "required": [
        "ok",
        "message",
        "severity",
        "overlays"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "const": "info"
        },
        "overlays": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "path",
              "fit",
              "reason"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "The file name, which import and add --template overlay: take."
              },
              "path": {
                "type": "string",
                "description": "Absolute."
              },
              "fit": {
                "enum": [
                  "compatible",
                  "incompatible",
                  "unknown"
                ]
              },
              "reason": {
                "type": "string"
              },
              "matched": {
                "type": "string",
                "description": "The sibling compatible the overlay adds, when it doesn't add the asked one."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "types": {
      "description": "A property type (src/protocol/types.ts Types).",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "subtype"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "subtype": {
              "enum": [
                "int",
                "float"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "string",
                "bool"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "options"
          ],
          "properties": {
            "kind": {
              "const": "enum"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "display_string": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "$ref": "#/$defs/types"
            },
            "min_items": {
              "type": "integer",
              "minimum": 0
            },
            "max_items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "tuple"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/types"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "property-value": {
      "anyOf": [
        {
          "type": [
            "null",
            "string",
            "number",
            "boolean"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property-value"
          }
        }
      ]
    }
  }
}
