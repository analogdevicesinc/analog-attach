{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "init.schema.json",
  "title": "init response",
  "description": "Standard output of init in JSON mode (INIT-040): the workfile created or kept, or the refusal of INIT-019. Configuration errors (INIT-001) go to standard error (config-error.schema.json).",
  "oneOf": [
    { "$ref": "#/$defs/ready" },
    { "$ref": "common.schema.json#/$defs/refusal" }
  ],
  "$defs": {
    "ready": {
      "type": "object",
      "required": ["ok", "message", "severity", "linux", "devicetree", "overlay", "created"],
      "properties": {
        "ok": { "const": true },
        "message": {
          "type": "string",
          "pattern": "^Workspace ready: linux .+, devicetree .+, overlay .+ \\((created|kept)\\)$"
        },
        "severity": { "const": "info" },
        "linux": { "type": "string", "pattern": "^/", "description": "The Linux tree configured, absolute." },
        "devicetree": { "type": "string", "pattern": "^/", "description": "The base devicetree configured, absolute." },
        "overlay": { "type": "string", "pattern": "^/", "description": "The overlay workfile now configured, absolute." },
        "created": { "type": "boolean", "description": "true when init created the workfile (INIT-034), false when it kept the configured one." }
      },
      "additionalProperties": false
    }
  }
}
