{
  "name": "attach-no-os-cli",
  "version": "0.0.1",
  "description": "CLI for Analog Attach no-OS workfile management",
  "private": true,
  "type": "module",
  "bin": {
    "aa": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup --silent && cp -r ../attach-no-os-lib/src/codegen/templates dist/ && cp -r completion dist/",
    "watch": "tsup --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo node_modules",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:e2e": "./test/e2e_build_all.sh",
    "test:e2e:adxl355": "./test/e2e_build.sh",
    "test:e2e:adt7420": "./test/e2e_build_adt7420.sh",
    "test:e2e:ad7124": "./test/e2e_build_ad7124.sh"
  },
  "tsup": {
    "entry": [
      "src/bin/cli.ts"
    ],
    "format": [
      "esm"
    ],
    "clean": true,
    "splitting": true,
    "noExternal": [
      "attach-no-os-lib"
    ],
    "external": [
      "yaml",
      "eta"
    ]
  },
  "devDependencies": {
    "@types/node": "20.x",
    "attach-no-os-lib": "workspace:*",
    "tsup": "^6.7.0",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@stricli/auto-complete": "^1.2.9",
    "@stricli/core": "^1.1.0",
    "eta": "^3.5.0",
    "yaml": "^2.7.1"
  }
}
