{
  "name": "attach-meta",
  "author": "AnalogDevices",
  "description": "Meta-tool that delegates commands to registered analog attachable tools",
  "license": "Apache-2.0",
  "type": "module",
  "version": "1.0.0",
  "files": [
    "dist"
  ],
  "bin": "dist/cli.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && tsup --silent",
    "clean": "rm -rf dist tsconfig.tsbuildinfo node_modules",
    "lint": "eslint src test",
    "format": "eslint src test --fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "coverage": "vitest run --coverage"
  },
  "tsup": {
    "entry": [
      "src/bin/cli.ts"
    ],
    "format": [
      "esm"
    ],
    "tsconfig": "tsconfig.json",
    "clean": true,
    "splitting": true,
    "minify": true,
    "loader": {
      ".json": "copy"
    }
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^13.1.0",
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "@types/node": "25.x",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.31.0",
    "eslint-plugin-unicorn": "^60.0.0",
    "tsup": "^6.7.0",
    "typescript": "5.6.x",
    "vitest": "^4.0.18"
  }
}
