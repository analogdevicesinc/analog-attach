{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analog-attach/base/tool-config-get",
  "description": "Base schema for tool-config-get. Fields is an optional variadic positional (zero or more field names; absent returns all).",
  "type": "object",
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-positional": true
    },
    "help": {
      "type": "boolean"
    }
  }
}
