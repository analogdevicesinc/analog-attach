{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analog-attach/base/move",
  "description": "Base schema for the move command. Src is a variadic positional (source path); --to is required.",
  "type": "object",
  "properties": {
    "src": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-positional": true,
      "minItems": 1
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "help": {
      "type": "boolean"
    }
  },
  "required": [
    "to",
    "src"
  ]
}
