{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analog-attach/base/add",
  "description": "Base schema for the add command. At least one of key (positional) or --name must be present.",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "x-positional": true
    },
    "name": {
      "type": "string"
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "help": {
      "type": "boolean"
    }
  },
  "anyOf": [
    {
      "required": [
        "key"
      ]
    },
    {
      "required": [
        "name"
      ]
    }
  ]
}