{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analog-attach/base/alias",
  "description": "Base schema for the alias command. Path is a variadic positional; exactly one of --with or --remove must be present.",
  "type": "object",
  "properties": {
    "path": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-positional": true
    },
    "with": {
      "type": "string"
    },
    "remove": {
      "type": "string"
    },
    "help": {
      "type": "boolean"
    }
  },
  "oneOf": [
    {
      "required": [
        "with"
      ]
    },
    {
      "required": [
        "remove"
      ]
    }
  ]
}
