{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analog-attach/base/rename",
  "description": "Base schema for the rename command. Path is a variadic positional; --to is required.",
  "type": "object",
  "properties": {
    "path": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "x-positional": true,
      "minItems": 1
    },
    "to": {
      "type": "string"
    },
    "help": {
      "type": "boolean"
    }
  },
  "required": [
    "to",
    "path"
  ]
}
