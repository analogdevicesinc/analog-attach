                                2
                            ],
                            "maximum": 4294967295,
                            "minimum": 0,
                            "type": "integer",
                            "typeSize": 32
                        },
                        "pl022,ctrl-len": {
                            "description": "Microwire interface - Control length",
                            "dtType": "uint32",
                            "maximum": 31,
                            "minimum": 3,
                            "type": "integer",
                            "typeSize": 32
                        },
                        "pl022,duplex": {
                            "description": "Microwire interface - Full/Half duplex",
                            "dtType": "uint32",
                            "enum": [
                                0,
                                1
                            ],
                            "maximum": 4294967295,
                            "minimum": 0,
                            "type": "integer",
                            "typeSize": 32
                        },
                        "pl022,interface": {
                            "description": "SPI interface type",
                            "dtType": "uint32",
                            "enum": [
                                0,
                                1,
                                2
                            ],
                            "maximum": 4294967295,
                            "minimum": 0,
                            "type": "integer",
                            "typeSize": 32
                        },
                        "pl022,rx-level-trig": {
                            "description": "Rx FIFO watermark level",
