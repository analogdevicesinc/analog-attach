                            "maximum": 4,
                            "minimum": 0,
                            "type": "integer",
                            "typeSize": 32
                        },
                        "pl022,tx-level-trig": {
                            "description": "Tx FIFO watermark level",
                            "dtType": "uint32",
                            "maximum": 4,
                            "minimum": 0,
                            "type": "integer",
                            "typeSize": 32
                        },
                        "pl022,wait-state": {
                            "description": "Microwire interface - Wait state",
                            "dtType": "uint32",
                            "enum": [
                                0,
                                1
                            ],
                            "maximum": 4294967295,
                            "minimum": 0,
                            "type": "integer",
                            "typeSize": 32
                        }
                    },
                    "title": "Peripheral-specific properties for Arm PL022 SPI controller"
                },
                {
                    "$id": "http://devicetree.org/schemas/spi/cdns,qspi-nor-peripheral-props.yaml#",
                    "additionalProperties": true,
                    "description": "See spi-peripheral-props.yaml for more info.",
                    "properties": {
                        "cdns,read-delay": {
                            "description": "Delay for read capture logic, in clock cycles.",
                            "dtType": "uint32",
                            "maximum": 4294967295,
                            "minimum": 0,
                            "type": "integer",
                            "typeSize": 32
                        },
                        "cdns,tchsh-ns": {
                            "description": "Delay in nanoseconds between last bit of current transaction and deasserting the device chip select (qspi_n_ss_out).",
                            "dtType": "uint32-array",
                            "items": {
                                "maximum": 4294967295,
                                "minimum": 0
                            },
                            "minItems": 1,
                            "type": "array"
                        },
                        "cdns,tsd2d-ns": {
                            "description": "Delay in nanoseconds between one chip select being de-activated and the activation of another.",
                            "dtType": "uint32-array",
                            "items": {
                                "maximum": 4294967295,
                                "minimum": 0
                            },
                            "minItems": 1,
                            "type": "array"
                        },
                        "cdns,tshsl-ns": {
                            "description": "Delay in nanoseconds for the length that the master mode chip select outputs are de-asserted between transactions.",
                            "dtType": "uint32-array",
                            "items": {
                                "maximum": 4294967295,
                                "minimum": 0
                            },
                            "minItems": 1,
                            "type": "array"
                        },
                        "cdns,tslch-ns": {
                            "description": "Delay in nanoseconds between setting qspi_n_ss_out low and first bit transfer.",
                            "dtType": "uint32-array",
                            "items": {
                                "maximum": 4294967295,
                                "minimum": 0
                            },
                            "minItems": 1,
                            "type": "array"
                        }
                    },
                    "title": "Peripheral-specific properties for the Cadence QSPI controller."
                },
                {
                    "$id": "http://devicetree.org/schemas/spi/fsl,dspi-peripheral-props.yaml#",
                    "additionalProperties": true,
                    "description": "See spi-peripheral-props.yaml for more info.",
                    "properties": {
                        "fsl,spi-cs-sck-delay": {
                            "deprecated": true,
                            "description": "Delay in nanoseconds between activating chip select and the start of clock signal, at the start of a transfer.",
                            "dtType": "uint32",
                            "maximum": 4294967295,
                            "minimum": 0,
                            "type": "integer",
                            "typeSize": 32
                        },
                        "fsl,spi-sck-cs-delay": {
                            "deprecated": true,
                            "description": "Delay in nanoseconds between stopping the clock signal and deactivating chip select, at the end of a transfer.",
                            "dtType": "uint32",
                            "maximum": 4294967295,
                            "minimum": 0,
                            "type": "integer",
                            "typeSize": 32
                        }
                    },
                    "title": "Peripheral-specific properties for Freescale DSPI controller"
                },
                {
                    "$id": "http://devicetree.org/schemas/spi/samsung,spi-peripheral-props.yaml#",
                    "additionalProperties": true,
                    "description": "See spi-peripheral-props.yaml for more info.",
                    "properties": {
                        "controller-data": {
                            "additionalProperties": false,
                            "properties": {
                                "samsung,spi-feedback-delay": {
                                    "default": 0,
                                    "description": "The sampling phase shift to be applied on the miso line (to account\nfor any lag in the miso line). Valid values:\n - 0: No phase shift.\n - 1: 90 degree phase shift sampling.\n - 2: 180 degree phase shift sampling.\n - 3: 270 degree phase shift sampling.\n",
                                    "dtType": "uint32",
                                    "enum": [
                                        0,
                                        1,
                                        2,
                                        3
                                    ],
                                    "maximum": 4294967295,
                                    "minimum": 0,
                                    "type": "integer",
                                    "typeSize": 32
                                }
                            },
                            "type": "object"
                        }
                    },
                    "title": "Peripheral-specific properties for Samsung S3C/S5P/Exynos SoC SPI controller"
                },
                {
                    "$id": "http://devicetree.org/schemas/spi/nvidia,tegra210-quad-peripheral-props.yaml#",
                    "additionalProperties": true,
                    "properties": {
                        "nvidia,rx-clk-tap-delay": {
                            "description": "Delays the clock coming in from the device with this tap value. Tap value varies based on platform design trace lengths from Tegra QSPI to corresponding slave device.",
                            "dtType": "uint32",
                            "maximum": 255,
                            "minimum": 0,
                            "type": "integer",
                            "typeSize": 32
                        },
                        "nvidia,tx-clk-tap-delay": {
                            "description": "Delays the clock going out to device with this tap value. Tap value varies based on platform design trace lengths from Tegra QSPI to corresponding slave device.",
                            "dtType": "uint32",
                            "maximum": 31,
                            "minimum": 0,
                            "type": "integer",
                            "typeSize": 32
                        }
                    },
                    "title": "Peripheral properties for Tegra Quad SPI Controller"
                }
            ],
            "description": "Many SPI controllers need to add properties to peripheral devices. They could be common properties like spi-max-frequency, spi-cpha, etc. or they could be controller specific like delay in clock or data lines, etc. These properties need to be defined in the peripheral node because they are per-peripheral and there can be multiple peripherals attached to a controller. All those properties are listed here. The controller specific properties should go in their own separate schema that should be referenced from here.",
            "properties": {
                "parallel-memories": {
                    "description": "Several SPI memories can be wired in parallel mode. The devices are physically on a different buses but will always act synchronously as each data word is spread across the different memories (eg. even bits are stored in one memory, odd bits in the other). This basically doubles the address space and the throughput while greatly complexifying the wiring because as many busses as devices must be wired. The size of each chip should be provided as members of the array.",
                    "dtType": "uint64-array",
                    "items": {
                        "dtType": "uint64",
                        "maximum": 18446744073709552000,
                        "minimum": 0,
                        "type": "integer",
                        "typeSize": 64
                    },
                    "maxItems": 4,
                    "minItems": 2,
                    "type": "array"
                },
                "rx-sample-delay-ns": {
                    "description": "SPI Rx sample delay offset, unit is nanoseconds. The delay from the default sample time before the actual sample of the rxd input signal occurs.",
                    "dtType": "uint32-array",
                    "items": {
                        "maximum": 4294967295,
                        "minimum": 0
                    },
                    "minItems": 1,
                    "type": "array"
                },
                "spi-cs-high": {
                    "description": "The device requires the chip select active high.",
                    "dtType": "flag",
                    "oneOf": [
                        {
                            "const": true,
                            "type": "boolean"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "spi-cs-hold-delay-ns": {
                    "description": "Delay in nanoseconds to be introduced by the controller before CS is de-asserted.",
                    "dtType": "uint32-array",
                    "items": {
                        "maximum": 4294967295,
                        "minimum": 0
                    },
                    "minItems": 1,
                    "type": "array"
                },
                "spi-cs-inactive-delay-ns": {
                    "description": "Delay in nanoseconds to be introduced by the controller after CS is de-asserted.",
                    "dtType": "uint32-array",
                    "items": {
                        "maximum": 4294967295,
                        "minimum": 0
                    },
                    "minItems": 1,
                    "type": "array"
                },
                "spi-cs-setup-delay-ns": {
                    "description": "Delay in nanoseconds to be introduced by the controller after CS is asserted.",
                    "dtType": "uint32-array",
                    "items": {
                        "maximum": 4294967295,
                        "minimum": 0
                    },
                    "minItems": 1,
                    "type": "array"
                },
                "spi-lsb-first": {
                    "description": "The device requires the LSB first mode.",
                    "dtType": "flag",
                    "oneOf": [
                        {
                            "const": true,
                            "type": "boolean"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "spi-rx-bus-width": {
                    "default": 1,
                    "description": "Bus width to the SPI bus used for read transfers. If 0 is provided, then no RX will be possible on this device.",
                    "dtType": "uint32",
                    "enum": [
                        0,
                        1,
                        2,
                        4,
                        8
                    ],
                    "maximum": 4294967295,
                    "minimum": 0,
                    "type": "integer",
                    "typeSize": 32
                },
                "spi-rx-delay-us": {
                    "description": "Delay, in microseconds, after a read transfer.",
                    "dtType": "uint32-array",
                    "items": {
                        "maximum": 4294967295,
                        "minimum": 0
                    },
                    "minItems": 1,
                    "type": "array"
                },
                "spi-tx-bus-width": {
                    "default": 1,
                    "description": "Bus width to the SPI bus used for write transfers. If 0 is provided, then no TX will be possible on this device.",
                    "dtType": "uint32",
                    "enum": [
                        0,
                        1,
                        2,
                        4,
                        8
                    ],
                    "maximum": 4294967295,
                    "minimum": 0,
                    "type": "integer",
                    "typeSize": 32
                },
                "spi-tx-delay-us": {
                    "description": "Delay, in microseconds, after a write transfer.",
                    "dtType": "uint32-array",
                    "items": {
                        "maximum": 4294967295,
                        "minimum": 0
                    },
                    "minItems": 1,
                    "type": "array"
                },
                "st,spi-midi-ns": {
                    "description": "Only for STM32H7, (Master Inter-Data Idleness) minimum time\ndelay in nanoseconds inserted between two consecutive data frames.\n",
                    "dtType": "uint32-array",
                    "items": {
                        "maximum": 4294967295,
                        "minimum": 0
                    },
                    "minItems": 1,
                    "type": "array"
                },
                "stacked-memories": {
                    "description": "Several SPI memories can be wired in stacked mode. This basically means that either a device features several chip selects, or that different devices must be seen as a single bigger chip. This basically doubles (or more) the total address space with only a single additional wire, while still needing to repeat the commands when crossing a chip boundary. The size of each chip should be provided as members of the array.",
                    "dtType": "uint64-array",
                    "items": {
                        "dtType": "uint64",
                        "maximum": 18446744073709552000,
                        "minimum": 0,
                        "type": "integer",
                        "typeSize": 64
                    },
                    "maxItems": 4,
                    "minItems": 2,
                    "type": "array"
                }
            },
            "title": "Peripheral-specific properties for a SPI bus."
        }
    ],
    "description": "Bindings for the Analog Devices AD4130 ADC. Datasheet can be found here:\n  https://www.analog.com/media/en/technical-documentation/data-sheets/AD4130-8.pdf\n",
    "examples": [
        "#include <dt-bindings/interrupt-controller/irq.h>\n\nspi {\n  #address-cells = <1>;\n  #size-cells = <0>;\n\n  adc@0 {\n    compatible = \"adi,ad4130\";\n    reg = <0>;\n\n    #address-cells = <1>;\n    #size-cells = <0>;\n\n    spi-max-frequency = <5000000>;\n    interrupts = <27 IRQ_TYPE_EDGE_FALLING>;\n    interrupt-parent = <&gpio>;\n\n    channel@0 {\n      reg = <0>;\n\n      adi,reference-select = <2>;\n\n      /* AIN8, AIN9 */\n      diff-channels = <8 9>;\n    };\n\n    channel@1 {\n      reg = <1>;\n\n      adi,reference-select = <2>;\n\n      /* AIN10, AIN11 */\n      diff-channels = <10 11>;\n    };\n\n    channel@2 {\n      reg = <2>;\n\n      adi,reference-select = <2>;\n\n      /* Temperature Sensor, DGND */\n      diff-channels = <16 19>;\n    };\n\n    channel@3 {\n      reg = <3>;\n\n      adi,reference-select = <2>;\n\n      /* Internal reference, DGND */\n      diff-channels = <18 19>;\n    };\n\n    channel@4 {\n      reg = <4>;\n\n      adi,reference-select = <2>;\n\n      /* DGND, DGND */\n      diff-channels = <19 19>;\n    };\n  };\n};\n"
    ],
    "patternProperties": {
        "^channel@([0-9a-f])$": {
            "$id": "http://devicetree.org/schemas/iio/adc/adc.yaml#",
            "additionalProperties": true,
            "anyOf": [
                {
                    "oneOf": [
                        {
                            "required": [
                                "reg",
                                "diff-channels"
                            ]
                        },
                        {
                            "required": [
                                "reg",
                                "single-channel"
                            ]
                        }
                    ]
                },
                {
                    "required": [
                        "reg"
                    ]
                }
            ],
            "description": "A few properties are defined in a common way ADC channels.",
            "properties": {
                "adi,buffered-negative": {
                    "description": "Enable buffered mode for negative input.",
                    "type": "boolean"
                },
                "adi,buffered-positive": {
                    "description": "Enable buffered mode for positive input.",
                    "type": "boolean"
                },
                "adi,burnout-current-nanoamp": {
                    "default": 0,
                    "description": "Burnout current in nanoamps to be applied for this channel.\n",
                    "dtType": "uint32-array",
                    "items": [
                        {
                            "enum": [
                                0,
                                500,
                                2000,
                                4000
                            ]
                        }
                    ],
                    "maxItems": 1,
                    "minItems": 1,
                    "type": "array"
                },
                "adi,excitation-current-0-nanoamp": {
                    "default": 0,
                    "description": "Excitation current in nanoamps to be applied to pin specified in\nadi,excitation-pin-0 while this channel is active.\n",
                    "dtType": "uint32-array",
                    "items": [
                        {
                            "enum": [
                                0,
                                100,
                                10000,
                                20000,
                                50000,
                                100000,
                                150000,
                                200000
                            ]
                        }
                    ],
                    "maxItems": 1,
                    "minItems": 1,
                    "type": "array"
                },
                "adi,excitation-current-1-nanoamp": {
                    "default": 0,
                    "description": "Excitation current in nanoamps to be applied to pin specified in\nadi,excitation-pin-1 while this channel is active.\n",
                    "dtType": "uint32-array",
                    "items": [
                        {
                            "enum": [
                                0,
                                100,
                                10000,
                                20000,
                                50000,
                                100000,
                                150000,
                                200000
                            ]
                        }
                    ],
                    "maxItems": 1,
                    "minItems": 1,
                    "type": "array"
                },
                "adi,excitation-pin-0": {
                    "default": 0,
                    "description": "Analog input to apply excitation current to while the channel\nis active.\n",
                    "dtType": "uint32",
                    "maximum": 15,
                    "minimum": 0,
                    "type": "integer",
                    "typeSize": 32
                },
                "adi,excitation-pin-1": {
                    "default": 0,
                    "description": "Analog input to apply excitation current to while this channel\nis active.\n",
                    "dtType": "uint32",
                    "maximum": 15,
                    "minimum": 0,
                    "type": "integer",
                    "typeSize": 32
                },
                "adi,reference-select": {
                    "default": 0,
                    "description": "Select the reference source to use when converting on the\nspecific channel. Valid values are:\n0: REFIN1(+)/REFIN1(−)\n1: REFIN2(+)/REFIN2(−)\n2: REFOUT/AVSS (Internal reference)\n3: AVDD/AVSS\nIf not specified, REFIN1 is used.\n",
                    "dtType": "uint32",
                    "enum": [
                        0,
                        1,
                        2,
                        3
                    ],
                    "maximum": 4294967295,
                    "minimum": 0,
                    "type": "integer",
                    "typeSize": 32
                },
                "diff-channels": {
                    "description": "Besides the analog inputs available, internal inputs can be used.\n16: Internal temperature sensor.\n17: AVSS\n18: Internal reference\n19: DGND\n20: (AVDD − AVSS)/6+\n21: (AVDD − AVSS)/6-\n22: (IOVDD − DGND)/6+\n23: (IOVDD − DGND)/6-\n24: (ALDO − AVSS)/6+\n25: (ALDO − AVSS)/6-\n26: (DLDO − DGND)/6+\n27: (DLDO − DGND)/6-\n28: V_MV_P\n29: V_MV_M\n",
                    "dtType": "uint32-array",
                    "items": {
                        "dtType": "uint32",
                        "maximum": 29,
                        "minimum": 0,
                        "type": "integer",
                        "typeSize": 32
                    },
                    "maxItems": 2,
                    "minItems": 2,
                    "type": "array"
                },
                "reg": {
                    "description": "The channel number.",
                    "dtType": "address",
                    "items": [
                        {
                            "items": [
                                {
                                    "maximum": 15,
                                    "minimum": 0,
                                    "type": "integer"
                                }
                            ],
                            "maxItems": 1,
                            "minItems": 1,
                            "type": "array"
                        }
                    ],
                    "maxItems": 1,
                    "minItems": 1,
                    "type": "array"
                }
            },
            "required": [
                "reg",
                "diff-channels"
            ],
            "title": "IIO Common Properties for ADC Channels",
            "type": "object",
            "unevaluatedProperties": false
        }
    },
    "properties": {
        "#address-cells": {
            "const": 1,
            "dtType": "uint32"
        },
        "#clock-cells": {
            "const": 0,
            "dtType": "uint32"
        },
        "#size-cells": {
            "const": 0,
            "dtType": "uint32"
        },
        "adi,bipolar": {
            "description": "Specify if the device should be used in bipolar mode.",
            "type": "boolean"
        },
        "adi,ext-clk-freq-hz": {
            "default": 76800,
            "description": "Specify the frequency of the external clock.",
            "dtType": "uint32-matrix",
            "items": [
                {
                    "items": [
                        {
                            "enum": [
                                76800,
                                153600
                            ]
                        }
                    ],
                    "maxItems": 1,
                    "minItems": 1,
                    "type": "array"
                }
            ],
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        },
        "adi,vbias-pins": {
            "description": "Analog inputs to apply a voltage bias of (AVDD − AVSS) / 2 to.",
            "dtType": "uint32-array",
            "items": {
                "maximum": 15,
                "minimum": 0,
                "type": "integer"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array"
        },
        "avdd-supply": {
            "description": "AVDD voltage supply. Can be used as reference for conversion.",
            "dtType": "phandle",
            "items": {
                "type": "array"
            },
            "type": "array"
        },
        "clock-names": {
            "dtType": "string-array",
            "items": [
                {
                    "const": "mclk"
                }
            ],
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        },
        "clock-output-names": {
            "dtType": "string-array",
            "items": {
                "type": "string"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        },
        "clocks": {
            "description": "phandle to the master clock (mclk)",
            "dtType": "phandle-array",
            "items": {
                "type": "array"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        },
        "compatible": {
            "dtType": "string-array",
            "items": [
                {
                    "enum": [
                        "adi,ad4130"
                    ]
                }
            ],
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        },
        "interrupt-names": {
            "description": "Specify which interrupt pin should be configured as Data Ready / FIFO\ninterrupt.\nDefault if not supplied is int.\n",
            "dtType": "string-array",
            "items": [
                {
                    "enum": [
                        "int",
                        "clk",
                        "p2",
                        "dout"
                    ]
                }
            ],
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        },
        "interrupt-parent": {
            "dtType": "phandle",
            "items": {
                "type": "array"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        },
        "interrupts": {
            "dtType": "uint32-matrix",
            "items": {
                "type": "array"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        },
        "iovdd-supply": {
            "description": "IOVDD voltage supply. Used for the chip interface.",
            "dtType": "phandle",
            "items": {
                "type": "array"
            },
            "type": "array"
        },
        "refin1-supply": {
            "description": "refin1 supply. Can be used as reference for conversion.",
            "dtType": "phandle",
            "items": {
                "type": "array"
            },
            "type": "array"
        },
        "refin2-supply": {
            "description": "refin2 supply. Can be used as reference for conversion.",
            "dtType": "phandle",
            "items": {
                "type": "array"
            },
            "type": "array"
        },
        "reg": {
            "description": "Chip select used by the device.",
            "dtType": "address",
            "items": {
                "items": [
                    {
                        "maximum": 256,
                        "minimum": 0,
                        "type": "integer"
                    }
                ],
                "maxItems": 1,
                "minItems": 1,
                "type": "array"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        },
        "spi-max-frequency": {
            "description": "Maximum SPI clocking speed of the device in Hz.",
            "dtType": "uint32",
            "maximum": 5000000,
            "minimum": 0,
            "type": "integer",
            "typeSize": 32
        }
    },
    "required": [
        "compatible",
        "reg",
        "interrupts"
    ],
    "title": "Analog Devices AD4130 ADC device driver",
    "type": "object",
    "unevaluatedProperties": false
}
