{
    "$id": "http://devicetree.org/schemas/clock/fixed-clock.yaml#",
    "additionalProperties": false,
    "examples": [
        "clock {\n  compatible = \"fixed-clock\";\n  #clock-cells = <0>;\n  clock-frequency = <1000000000>;\n  clock-accuracy = <100>;\n};\n"
    ],
    "patternProperties": {
        "^pinctrl-[0-9]+$": {
            "dtType": "phandle-array",
            "items": {
                "additionalItems": {
                    "dtType": "uint32",
                    "maximum": 4294967295,
                    "minimum": 0,
                    "type": "integer",
                    "typeSize": 32
                },
                "items": [
                    {
                        "oneOf": [
                            {
                                "maximum": 4294967295,
                                "minimum": 1,
                                "type": "integer"
                            },
                            {
                                "const": 0,
                                "type": "integer"
                            }
                        ]
                    }
                ],
                "maxItems": 1024,
                "minItems": 1,
                "type": "array"
            },
            "minItems": 1,
            "type": "array"
        }
    },
    "properties": {
        "#clock-cells": {
            "const": 0,
            "description": "Number of cells in a clock specifier; Typically 0 for nodes with a single clock output and 1 for nodes with multiple clock outputs.",
            "dtType": "uint32"
        },
        "$nodename": {
            "anyOf": [
                {
                    "description": "Preferred name is 'clock-<freq>' with <freq> being the output frequency as defined in the 'clock-frequency' property.",
                    "items": [
                        {
                            "pattern": "^clock-([0-9]+|[a-z0-9-]+)$"
                        }
                    ],
                    "maxItems": 1,
                    "minItems": 1,
                    "type": "array"
                },
                {
                    "deprecated": true,
                    "description": "Any name allowed"
                }
            ],
            "dtType": "string"
        },
        "clock-accuracy": {
            "description": "accuracy of clock in ppb (parts per billion).",
            "dtType": "uint32",
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer",
            "typeSize": 32
        },
        "clock-frequency": {
            "description": "Legacy property for single, fixed frequency clocks",
            "dtType": "uint32"
        },
        "clock-output-names": {
            "description": "Recommended to be a list of strings of clock output signal\nnames indexed by the first cell in the clock specifier.\nHowever, the meaning of clock-output-names is domain\nspecific to the clock provider, and is only provided to\nencourage using the same meaning for the majority of clock\nproviders.  This format may not work for clock providers\nusing a complex clock specifier format.  In those cases it\nis recommended to omit this property and create a binding\nspecific names property.\n\nClock consumer nodes must never directly reference\nthe provider\\'s clock-output-names property.\n",
            "dtType": "string-array",
            "items": {
                "type": "string"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        },
        "compatible": {
            "dtType": "string-array",
            "items": [
                {
                    "const": "fixed-clock",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9,+\\-._/]+$"
                }
            ],
            "maxItems": 1,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
        },
        "pinctrl-names": {
            "dtType": "string-array",
            "items": {
                "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
        }
    },
    "required": [
        "compatible",
        "#clock-cells",
        "clock-frequency"
    ],
    "title": "Simple fixed-rate clock sources",
    "type": "object"
}
