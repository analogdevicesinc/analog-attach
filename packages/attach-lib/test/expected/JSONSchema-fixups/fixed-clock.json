{
    "$id": "http://devicetree.org/schemas/clock/fixed-clock.yaml#",
    "additionalProperties": false,
    "examples": [
        "clock {\n  compatible = \"fixed-clock\";\n  #clock-cells = <0>;\n  clock-frequency = <1000000000>;\n  clock-accuracy = <100>;\n};\n"
    ],
    "properties": {
        "#clock-cells": {
            "const": 0,
            "dtType": "uint32"
        },
        "$nodename": {
            "anyOf": [
                {
                    "description": "Preferred name is 'clock-<freq>' with <freq> being the output frequency as defined in the 'clock-frequency' property.",
                    "items": [
                        {
                            "pattern": "^clock-([0-9]+|[a-z0-9-]+)$"
                        }
                    ],
                    "maxItems": 1,
                    "minItems": 1,
                    "type": "array"
                },
                {
                    "deprecated": true,
                    "description": "Any name allowed"
                }
            ],
            "dtType": "string"
        },
        "clock-accuracy": {
            "description": "accuracy of clock in ppb (parts per billion).",
            "dtType": "uint32",
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer",
            "typeSize": 32
        },
        "clock-frequency": {
            "dtType": "uint32"
        },
        "clock-output-names": {
            "dtType": "string-array",
            "items": {
                "type": "string"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        },
        "compatible": {
            "dtType": "string-array",
            "items": [
                {
                    "const": "fixed-clock"
                }
            ],
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        }
    },
    "required": [
        "compatible",
        "#clock-cells",
        "clock-frequency"
    ],
    "title": "Simple fixed-rate clock sources",
    "type": "object"
}
