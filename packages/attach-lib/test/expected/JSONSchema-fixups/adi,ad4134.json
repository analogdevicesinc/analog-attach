{
    "$id": "http://devicetree.org/schemas/iio/adc/adi,ad4134.yaml#",
    "additionalProperties": false,
    "description": "The AD4134 is a quad channel, low noise, simultaneous sampling,\nprecision analog-to-digital converter (ADC) that delivers on\nfunctionality, performance, and ease of use.\n\n  https://www.analog.com/en/products/ad4134.html\n",
    "examples": [
        "#include <dt-bindings/gpio/gpio.h>\n\nspi {\n  #address-cells = <1>;\n  #size-cells = <0>;\n\n  adc@0 {\n    compatible = \"adi,ad4134\";\n    reg = <0>;\n\n    spi-max-frequency = <1000000>;\n\n    reset-gpios = <&gpio0 86 GPIO_ACTIVE_LOW>;\n\n    clocks = <&sys_clk>;\n    clock-names = \"sys_clk\";\n\n    dmas = <&rx_dma 0>;\n    dma-names = \"rx\";\n\n    pwms = <&ad4134_odr_generator 0 0>;\n    pwm-names = \"odr_pwm\";\n\n    avdd5-supply = <&avdd5>;\n    avdd1v8-supply = <&avdd1v8>;\n    iovdd-supply = <&iovdd>;\n    refin-supply = <&refin>;\n\n    adi,spi-engine = <&ad4134_spi_engine>;\n  };\n};\n"
    ],
    "patternProperties": {
        "^pinctrl-[0-9]+$": {
            "dtType": "phandle-array",
            "items": {
                "additionalItems": {
                    "dtType": "uint32",
                    "maximum": 4294967295,
                    "minimum": 0,
                    "type": "integer",
                    "typeSize": 32
                },
                "items": [
                    {
                        "oneOf": [
                            {
                                "maximum": 4294967295,
                                "minimum": 1,
                                "type": "integer"
                            },
                            {
                                "const": 0,
                                "type": "integer"
                            }
                        ]
                    }
                ],
                "maxItems": 1024,
                "minItems": 1,
                "type": "array"
            },
            "minItems": 1,
            "type": "array"
        }
    },
    "properties": {
        "adi,spi-engine": {
            "description": "phandle of the SPI slave connected to the SPI engine master",
            "dtType": "phandle",
            "items": {
                "additionalItems": {
                    "dtType": "uint32",
                    "maximum": 4294967295,
                    "minimum": 0,
                    "type": "integer",
                    "typeSize": 32
                },
                "items": [
                    {
                        "oneOf": [
                            {
                                "maximum": 4294967295,
                                "minimum": 1,
                                "type": "integer"
                            },
                            {
                                "const": 0,
                                "type": "integer"
                            }
                        ]
                    }
                ],
                "maxItems": 1,
                "minItems": 1,
                "type": "array"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        },
        "avdd1v8-supply": {
            "dtType": "phandle",
            "items": {
                "type": "array"
            },
            "type": "array"
        },
        "avdd5-supply": {
            "dtType": "phandle",
            "items": {
                "type": "array"
            },
            "type": "array"
        },
        "clock-names": {
            "description": "List of clock input name strings sorted in the same order as the clocks property.  Consumers drivers will use clock-names to match clock input names with clocks specifiers.",
            "dtType": "string-array",
            "items": [
                {
                    "const": "sys_clk",
                    "type": "string"
                }
            ],
            "maxItems": 1,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
        },
        "clocks": {
            "description": "List of phandle and clock specifier pairs, one pair\nfor each clock input to the device.  Note: if the\nclock provider specifies '0' for #clock-cells, then\nonly the phandle portion of the pair will appear.\n",
            "dtType": "phandle-array",
            "items": {
                "additionalItems": {
                    "dtType": "uint32",
                    "maximum": 4294967295,
                    "minimum": 0,
                    "type": "integer",
                    "typeSize": 32
                },
                "items": [
                    {
                        "oneOf": [
                            {
                                "maximum": 4294967295,
                                "minimum": 1,
                                "type": "integer"
                            },
                            {
                                "const": 0,
                                "type": "integer"
                            }
                        ]
                    }
                ],
                "maxItems": 1024,
                "minItems": 1,
                "type": "array"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        },
        "compatible": {
            "dtType": "string-array",
            "items": [
                {
                    "enum": [
                        "adi,ad4134"
                    ],
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9,+\\-._/]+$"
                }
            ],
            "maxItems": 1,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
        },
        "dma-names": {
            "anyOf": [
                {
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1,
                    "type": "array",
                    "uniqueItems": true
                },
                {
                    "items": {
                        "enum": [
                            "rx",
                            "tx"
                        ]
                    },
                    "minItems": 1,
                    "type": "array"
                }
            ],
            "dtType": "string-array",
            "items": [
                {
                    "const": "rx",
                    "type": "string"
                }
            ],
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        },
        "dmas": {
            "dtType": "phandle-array",
            "items": {
                "additionalItems": {
                    "dtType": "uint32",
                    "maximum": 4294967295,
                    "minimum": 0,
                    "type": "integer",
                    "typeSize": 32
                },
                "items": [
                    {
                        "oneOf": [
                            {
                                "maximum": 4294967295,
                                "minimum": 1,
                                "type": "integer"
                            },
                            {
                                "const": 0,
                                "type": "integer"
                            }
                        ]
                    }
                ],
                "maxItems": 1024,
                "minItems": 1,
                "type": "array"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        },
        "iovdd-supply": {
            "dtType": "phandle",
            "items": {
                "type": "array"
            },
            "type": "array"
        },
        "pinctrl-names": {
            "dtType": "string-array",
            "items": {
                "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
        },
        "pwm-names": {
            "dtType": "string-array",
            "items": [
                {
                    "const": "odr_pwm",
                    "type": "string"
                }
            ],
            "maxItems": 1,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
        },
        "pwms": {
            "dtType": "phandle-array",
            "items": {
                "additionalItems": {
                    "dtType": "uint32",
                    "maximum": 4294967295,
                    "minimum": 0,
                    "type": "integer",
                    "typeSize": 32
                },
                "items": [
                    {
                        "oneOf": [
                            {
                                "maximum": 4294967295,
                                "minimum": 1,
                                "type": "integer"
                            },
                            {
                                "const": 0,
                                "type": "integer"
                            }
                        ]
                    }
                ],
                "maxItems": 1024,
                "minItems": 1,
                "type": "array"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        },
        "refin-supply": {
            "dtType": "phandle",
            "items": {
                "type": "array"
            },
            "type": "array"
        },
        "reg": {
            "dtType": "address",
            "items": {
                "dtType": "uint32-array",
                "items": {
                    "dtType": "uint32",
                    "maximum": 4294967295,
                    "minimum": 0,
                    "type": "integer",
                    "typeSize": 32
                },
                "maxItems": 5,
                "minItems": 1,
                "type": "array"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        },
        "reset-gpios": {
            "description": "GPIO (or GPIOs for power sequence) connected to the device reset pin (e.g. RESET or RESETN).",
            "dtType": "phandle-array",
            "items": {
                "type": "array"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        },
        "spi-max-frequency": {
            "dtType": "uint32",
            "maximum": 1000000,
            "type": "integer"
        },
        "status": {
            "allOf": [
                {
                    "allOf": [
                        {
                            "dtType": "non-unique-string-array",
                            "items": {
                                "type": "string"
                            },
                            "minItems": 1,
                            "type": "array"
                        },
                        {
                            "uniqueItems": true
                        }
                    ],
                    "dtType": "string-array"
                },
                {
                    "maxItems": 1,
                    "minItems": 1,
                    "type": "array"
                }
            ],
            "dtType": "string",
            "items": [
                {
                    "enum": [
                        "okay",
                        "disabled",
                        "reserved",
                        "fail",
                        "fail-needs-probe"
                    ]
                }
            ],
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        }
    },
    "required": [
        "compatible",
        "reg",
        "clocks",
        "clock-names",
        "dmas",
        "dma-names",
        "pwms",
        "pwm-names",
        "refin-supply",
        "adi,spi-engine"
    ],
    "title": "Analog Devices AD4134 ADC",
    "type": "object"
}
