                                            }
                                        ],
                                        "maxItems": 1,
                                        "minItems": 1,
                                        "type": "array"
                                    }
                                ],
                                "maxItems": 1,
                                "minItems": 1,
                                "type": "array"
                            },
                            "st,adc-channels": {
                                "items": {
                                    "maximum": 15,
                                    "minimum": 0,
                                    "type": "integer"
                                },
                                "maxItems": 16,
                                "minItems": 1,
                                "type": "array"
                            },
                            "st,adc-diff-channels": false,
                            "st,min-sample-time-nsecs": {
                                "items": {
                                    "minimum": 80,
                                    "type": "integer"
                                },
                                "maxItems": 16,
                                "minItems": 1,
                                "type": "array"
                            }
                        },
                        "required": [
                            "clocks"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "compatible": {
                                "contains": {
                                    "enum": [
                                        "st,stm32h7-adc",
                                        "st,stm32mp1-adc"
