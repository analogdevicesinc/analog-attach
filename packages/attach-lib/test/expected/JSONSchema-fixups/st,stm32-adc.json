                            "assigned-resolution-bits": {
                                "default": 16,
                                "items": [
                                    {
                                        "enum": [
                                            8,
                                            10,
                                            12,
                                            14,
                                            16
                                        ]
                                    }
                                ],
                                "maxItems": 1,
                                "minItems": 1,
                                "type": "array"
                            },
                            "interrupt-parent": {
                                "maxItems": 1,
                                "minItems": 1,
                                "type": "array"
                            },
                            "interrupts": {
                                "maximum": 1,
                                "minimum": 0,
                                "type": "integer"
                            },
                            "reg": {
                                "items": [
                                    {
                                        "items": [
                                            {
                                                "enum": [
                                                    0,
                                                    256
                                                ]
                                            }
                                        ],
                                        "maxItems": 1,
                                        "minItems": 1,
                                        "type": "array"
                                    }
                                ],
                                "maxItems": 1,
                                "minItems": 1,
                                "type": "array"
                            },
                            "st,adc-channels": {
                                "items": {
                                    "maximum": 19,
                                    "minimum": 0,
                                    "type": "integer"
                                },
                                "maxItems": 20,
                                "minItems": 1,
                                "type": "array"
                            },
                            "st,min-sample-time-nsecs": {
                                "items": {
                                    "minimum": 40,
                                    "type": "integer"
                                },
                                "maxItems": 20,
                                "minItems": 1,
                                "type": "array"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "compatible": {
                                "contains": {
                                    "const": "st,stm32mp13-adc"
                                },
                                "type": "array"
                            }
                        },
                        "required": [
                            "compatible"
                        ],
                        "type": "object"
                    },
                    "then": {
                        "properties": {
                            "__canary__": false,
                            "assigned-resolution-bits": {
                                "default": 12,
                                "items": [
                                    {
                                        "enum": [
                                            6,
                                            8,
                                            10,
                                            12
                                        ]
                                    }
                                ],
                                "maxItems": 1,
                                "minItems": 1,
                                "type": "array"
                            },
                            "interrupt-parent": {
                                "maxItems": 1,
                                "minItems": 1,
                                "type": "array"
                            },
                            "interrupts": {
                                "const": 0
                            },
                            "reg": {
                                "items": [
                                    {
                                        "items": [
                                            {
                                                "const": 0
                                            }
                                        ],
                                        "maxItems": 1,
                                        "minItems": 1,
                                        "type": "array"
                                    }
                                ],
                                "maxItems": 1,
                                "minItems": 1,
                                "type": "array"
                            },
                            "st,adc-channels": {
                                "items": {
                                    "maximum": 18,
                                    "minimum": 0,
                                    "type": "integer"
                                },
                                "maxItems": 19,
                                "minItems": 1,
                                "type": "array"
                            },
                            "st,min-sample-time-nsecs": {
                                "items": {
                                    "minimum": 40,
                                    "type": "integer"
                                },
                                "maxItems": 19,
                                "minItems": 1,
                                "type": "array"
                            }
                        }
                    }
                }
            ],
            "description": "An ADC block node should contain at least one subnode, representing an ADC instance available on the machine.",
            "patternProperties": {
                "^channel@([0-9]|1[0-9])$": {
                    "$id": "http://devicetree.org/schemas/iio/adc/adc.yaml#",
                    "additionalProperties": false,
                    "anyOf": [
                        {
                            "oneOf": [
                                {
                                    "required": [
                                        "reg",
                                        "diff-channels"
                                    ]
                                },
                                {
                                    "required": [
                                        "reg",
                                        "single-channel"
                                    ]
                                }
                            ]
                        },
                        {
                            "required": [
                                "reg"
                            ]
                        }
                    ],
                    "description": "Represents the external channels which are connected to the ADC.",
                    "properties": {
                        "diff-channels": {
                            "description": "Many ADCs have dual Muxes to allow different input pins to be routed to both the positive and negative inputs of a differential ADC. The first value specifies the positive input pin, the second specifies the negative input pin.",
                            "dtType": "uint32-array",
                            "items": {
                                "dtType": "uint32",
                                "maximum": 19,
                                "minimum": 0,
                                "type": "integer",
                                "typeSize": 32
                            },
                            "maxItems": 2,
                            "minItems": 1,
                            "type": "array"
                        },
                        "label": {
                            "description": "Unique name to identify which channel this is.\nReserved label names \"vddcore\", \"vddcpu\", \"vddq_ddr\", \"vrefint\" and \"vbat\"\nare used to identify internal channels with matching names.\n",
                            "dtType": "string"
                        },
                        "reg": {
                            "dtType": "address",
                            "items": [
                                {
                                    "items": [
                                        {
                                            "maximum": 19,
                                            "minimum": 0,
                                            "type": "integer"
                                        }
                                    ],
                                    "maxItems": 1,
                                    "minItems": 1,
                                    "type": "array"
                                }
                            ],
                            "maxItems": 1,
                            "minItems": 1,
                            "type": "array"
                        },
                        "st,min-sample-time-ns": {
                            "description": "Minimum sampling time in nanoseconds. Depending on hardware (board)\ne.g. high/low analog input source impedance, fine tune of ADC\nsampling time may be recommended.\n",
                            "dtType": "uint32-array",
                            "items": {
                                "maximum": 4294967295,
                                "minimum": 0
                            },
                            "minItems": 1,
                            "type": "array"
                        }
                    },
                    "required": [
                        "reg"
                    ],
                    "title": "IIO Common Properties for ADC Channels",
                    "type": "object"
                }
            },
            "properties": {
                "#address-cells": {
                    "const": 1,
                    "dtType": "uint32"
                },
                "#io-channel-cells": {
                    "const": 1,
                    "dtType": "uint32"
                },
                "#size-cells": {
                    "const": 0,
                    "dtType": "uint32"
                },
                "assigned-resolution-bits": {
                    "description": "Resolution (bits) to use for conversions:\n  - can be 6, 8, 10 or 12 on stm32f4 and stm32mp13\n  - can be 8, 10, 12, 14 or 16 on stm32h7 and stm32mp1\n",
                    "dtType": "uint32-array",
                    "items": {
                        "maximum": 4294967295,
                        "minimum": 0
                    },
                    "minItems": 1,
                    "type": "array"
                },
                "clocks": {
                    "description": "Input clock private to this ADC instance. It's required only on stm32f4, that has per instance clock input for registers access.",
                    "dtType": "phandle-array",
                    "items": {
                        "type": "array"
                    },
                    "maxItems": 1,
                    "minItems": 1,
                    "type": "array"
                },
                "compatible": {
                    "dtType": "string-array",
                    "items": [
                        {
                            "enum": [
                                "st,stm32f4-adc",
                                "st,stm32h7-adc",
                                "st,stm32mp1-adc",
                                "st,stm32mp13-adc"
                            ]
                        }
                    ],
                    "maxItems": 1,
                    "minItems": 1,
                    "type": "array"
                },
                "dma-names": {
                    "dtType": "string-array",
                    "items": [
                        {
                            "const": "rx"
                        }
                    ],
                    "maxItems": 1,
                    "minItems": 1,
                    "type": "array"
                },
                "dmas": {
                    "description": "RX DMA Channel",
                    "dtType": "phandle-array",
                    "items": {
                        "type": "array"
                    },
                    "maxItems": 1,
                    "minItems": 1,
                    "type": "array"
                },
                "interrupt-parent": {
                    "dtType": "phandle",
                    "items": {
                        "type": "array"
                    },
                    "maxItems": 1,
                    "minItems": 1,
                    "type": "array"
                },
                "interrupts": {
                    "description": "IRQ Line for the ADC instance. Valid values are:\n  - 0 for adc@0 (single adc for stm32mp13)\n  - 1 for adc@100\n  - 2 for adc@200 (stm32f4 only)\n",
                    "dtType": "uint32-matrix",
                    "items": {
                        "type": "array"
                    },
                    "maxItems": 1,
                    "minItems": 1,
                    "type": "array"
                },
                "nvmem-cell-names": {
                    "dtType": "string-array",
                    "items": [
                        {
                            "const": "vrefint"
                        }
                    ],
                    "maxItems": 1,
                    "minItems": 1,
                    "type": "array"
                },
                "nvmem-cells": {
                    "items": [
                        {
                            "description": "Phandle to the calibration vrefint data provided by otp"
                        }
                    ],
                    "maxItems": 1,
                    "minItems": 1,
                    "type": "array"
                },
                "reg": {
                    "description": "Offset of ADC instance in ADC block. Valid values are:\n  - 0x0:   ADC1\n  - 0x100: ADC2\n  - 0x200: ADC3 (stm32f4 only)\n",
                    "dtType": "address",
                    "items": {
                        "type": "array"
                    },
                    "maxItems": 1,
                    "minItems": 1,
                    "type": "array"
                },
                "st,adc-channels": {
                    "deprecated": true,
                    "description": "List of single-ended channels muxed for this ADC. It can have up to:\n  - 16 channels, numbered from 0 to 15 (for in0..in15) on stm32f4\n  - 19 channels, numbered from 0 to 18 (for in0..in18) on stm32mp13.\n  - 20 channels, numbered from 0 to 19 (for in0..in19) on stm32h7 and\n    stm32mp1.\n",
                    "dtType": "uint32-array",
                    "items": {
                        "dtType": "uint32",
                        "maximum": 4294967295,
                        "minimum": 0,
                        "type": "integer",
                        "typeSize": 32
