    "pattern_properties": [
        {
            "pattern": "^channel@([0-9]|1[0-5])$",
            "description": "Represents the external channels which are connected to the ADC.\n",
            "properties": [
                {
                    "key": "reg",
                    "value": {
                        "_t": "matrix",
                        "minItems": 1,
                        "maxItems": 1,
                        "rows": [
                            {
                                "_t": "list",
                                "item": {
                                    "_t": "number",
                                    "minimum": 0,
                                    "maximum": 15
                                },
                                "minItems": 1,
                                "maxItems": 1
                            }
                        ],
                        "description": "The channel number. It can have up to 8 channels on ad7124-4\nand 16 channels on ad7124-8, numbered from 0 to 15.\n"
                    }
                },
                {
                    "key": "adi,reference-select",
                    "value": {
                        "_t": "scalar",
                        "cell": {
                            "_t": "enum",
                            "enum": [
                                0,
                                1,
                                3
                            ],
                            "enum_type": "number"
                        },
                        "typeSize": 32,
                        "description": "Select the reference source to use when converting on\nthe specific channel. Valid values are:\n0: REFIN1(+)/REFIN1(−).\n1: REFIN2(+)/REFIN2(−).\n3: AVDD\nIf this field is left empty, internal reference is selected.\n"
                    }
                },
                {
                    "key": "diff-channels",
                    "value": {
                        "_t": "list",
                        "item": {
                            "_t": "number",
                            "minimum": 0,
                            "maximum": 4294967295
                        },
                        "minItems": 2,
                        "maxItems": 2,
                        "typeSize": 32,
                        "description": "Many ADCs have dual Muxes to allow different input pins to be routed to both the positive and negative inputs of a differential ADC. The first value specifies the positive input pin, the second specifies the negative input pin. There are also some ADCs, where the differential channel has dedicated positive and negative inputs which can be used to measure differential voltage levels. For those setups, this property can be configured with the 'reg' property for both inputs (i.e. diff-channels = <reg reg>)."
                    }
                },
                {
                    "key": "bipolar",
                    "value": {
                        "_t": "flag",
                        "description": "If provided, the channel is to be used in bipolar mode."
                    }
                },
                {
                    "key": "adi,buffered-positive",
                    "value": {
                        "_t": "flag",
                        "description": "Enable buffered mode for positive input."
                    }
                },
                {
                    "key": "adi,buffered-negative",
                    "value": {
                        "_t": "flag",
                        "description": "Enable buffered mode for negative input."
                    }
                }
            ],
            "required": [
                "reg",
                "diff-channels"
            ]
        }
    ],
    "examples": [
        "#include <dt-bindings/gpio/gpio.h>\nspi {\n  #address-cells = <1>;\n  #size-cells = <0>;\n\n  adc@0 {\n    compatible = \"adi,ad7124-4\";\n    reg = <0>;\n    spi-max-frequency = <5000000>;\n    interrupts = <25 2>;\n    interrupt-parent = <&gpio>;\n    rdy-gpios = <&gpio 25 GPIO_ACTIVE_LOW>;\n    refin1-supply = <&adc_vref>;\n\n    #address-cells = <1>;\n    #size-cells = <0>;\n\n    channel@0 {\n      reg = <0>;\n      diff-channels = <0 1>;\n      adi,reference-select = <0>;\n      adi,buffered-positive;\n    };\n\n    channel@1 {\n      reg = <1>;\n      bipolar;\n      diff-channels = <2 3>;\n      adi,reference-select = <0>;\n      adi,buffered-positive;\n      adi,buffered-negative;\n    };\n\n    channel@2 {\n      reg = <2>;\n      diff-channels = <4 5>;\n    };\n\n    channel@3 {\n      reg = <3>;\n      diff-channels = <6 7>;\n    };\n  };\n};\n"
    ]
}