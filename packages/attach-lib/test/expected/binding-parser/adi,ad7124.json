            }
        },
        {
            "key": "#clock-cells",
            "value": {
                "_t": "scalar",
                "cell": {
                    "_t": "enum",
                    "enum": [
                        0
                    ],
                    "enum_type": "number"
                },
                "default": 0,
                "description": "The CLK pin can be used as an output. When that is the case, include this property."
            }
