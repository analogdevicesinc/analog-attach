                "cell": {
                    "_t": "enum",
                    "enum": [
                        0,
                        1,
                        2,
                        4,
                        8
                    ],
                    "enum_type": "number"
                },
                "typeSize": 32,
                "default": 1,
                "description": "Bus width to the SPI bus used for read transfers. If 0 is provided, then no RX will be possible on this device."
            }
        },
        {
            "key": "spi-rx-delay-us",
            "value": {
                "_t": "list",
                "item": {
                    "_t": "number",
                    "minimum": 0,
                    "maximum": 4294967295
