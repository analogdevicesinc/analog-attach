{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delete.schema.json",
  "title": "delete response",
  "description": "Standard output of delete in JSON mode: a preview (DELETE-012, DELETE-024), a success (DELETE-013, DELETE-027, DELETE-032), or a refusal. $defs/base is DeleteResponse (overview 2.1).",
  "anyOf": [{ "$ref": "#/$defs/linux" }, { "$ref": "#/$defs/noos" }],
  "$defs": {
    "base": {
      "description": "DeleteResponse: a CommonResponse, or a DeletePreview.",
      "anyOf": [{ "$ref": "common.schema.json#/$defs/common" }, { "$ref": "#/$defs/base-preview" }]
    },
    "base-preview": {
      "description": "DeletePreview: what the delete would remove; nothing was removed.",
      "allOf": [{ "$ref": "common.schema.json#/$defs/common" }],
      "required": ["node_count", "property_count", "paths"],
      "properties": {
        "node_count": { "type": "integer", "minimum": 0 },
        "property_count": { "type": "integer", "minimum": 0 },
        "paths": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "linux": {
      "oneOf": [
        { "$ref": "#/$defs/linux-preview" },
        { "allOf": [{ "$ref": "common.schema.json#/$defs/done" }], "properties": { "severity": { "const": "info" } } },
        { "$ref": "common.schema.json#/$defs/refusal" }
      ]
    },
    "linux-preview": {
      "allOf": [{ "$ref": "#/$defs/base-preview" }],
      "properties": {
        "ok": { "const": true },
        "message": { "type": "string", "pattern": "^Would delete [0-9]+ node\\(s\\) and [0-9]+ property\\(ies\\)$" },
        "severity": { "const": "warn" },
        "paths": {
          "description": "The counted nodes, as segments from the fragment's target (no path) or from the deleted node (with a path) (D-5).",
          "type": "array",
          "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      },
      "unevaluatedProperties": false
    },
    "noos": {
      "anyOf": [
        { "$ref": "#/$defs/noos-preview" },
        {
          "description": "Where the backend is noos: a property reset or nodes deleted (DELETE-510, DELETE-512).",
          "allOf": [{ "$ref": "common.schema.json#/$defs/done" }],
          "properties": {
            "message": { "type": "string", "pattern": "^(Reset .+|Deleted .+)$" },
            "severity": { "const": "info" }
          }
        },
        { "$ref": "common.schema.json#/$defs/refusal" }
      ]
    },
    "noos-preview": {
      "description": "Where the backend is noos: delete without --force (DELETE-500, DELETE-502). paths has the nodes that would go, each [<name>], then the properties whose reference would be cleared, each [<node>, <property>].",
      "allOf": [{ "$ref": "#/$defs/base-preview" }],
      "properties": {
        "ok": { "const": true },
        "message": { "type": "string", "pattern": "Re-run with --force\\.$" },
        "severity": { "const": "warn" },
        "paths": { "type": "array", "items": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string", "minLength": 1 } } }
      },
      "unevaluatedProperties": false
    }
  }
}
