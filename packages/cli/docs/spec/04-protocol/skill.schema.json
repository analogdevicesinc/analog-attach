{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill.schema.json",
  "title": "skill response",
  "description": "Standard output of skill install and skill uninstall in JSON mode (SKILL-030), the list of the backend's skills with no name (SKILL-022), or a refusal (SKILL-001, SKILL-002, SKILL-010). The front end's: the same for every backend.",
  "oneOf": [
    {
      "type": "object",
      "required": ["ok", "message", "severity", "path"],
      "properties": {
        "ok": { "const": true },
        "message": { "type": "string", "pattern": "^(Installed skill .+ to|Removed skill .+ from) /.+$" },
        "severity": { "const": "info" },
        "path": { "type": "string", "pattern": "^/", "description": "The skill's directory, absolute: ~/.claude/skills/<name>." }
      },
      "additionalProperties": false
    },
    {
      "description": "skill install or skill uninstall with no name (SKILL-022).",
      "type": "object",
      "required": ["ok", "message", "severity", "skills"],
      "properties": {
        "ok": { "const": true },
        "message": { "type": "string", "pattern": "^(Skills of the .+ backend: .+|The .+ backend has no skills)$" },
        "severity": { "const": "info" },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "about", "installed", "path"],
            "properties": {
              "name": { "type": "string" },
              "about": { "type": "string" },
              "installed": { "type": "boolean" },
              "path": { "type": "string", "pattern": "^/" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    { "$ref": "common.schema.json#/$defs/refusal" }
  ]
}
