{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill.schema.json",
  "title": "skill response",
  "description": "Standard output of skill install and skill uninstall in JSON mode (SKILL-030), or a refusal (SKILL-001, SKILL-002, SKILL-010). The front end's: the same for every backend.",
  "oneOf": [
    {
      "type": "object",
      "required": ["ok", "message", "severity", "path"],
      "properties": {
        "ok": { "const": true },
        "message": { "type": "string", "pattern": "^(Installed skill .+ to|Removed skill .+ from) /.+$" },
        "severity": { "const": "info" },
        "path": { "type": "string", "pattern": "^/", "description": "The skill's directory, absolute: ~/.claude/skills/<name>." }
      },
      "additionalProperties": false
    },
    { "$ref": "common.schema.json#/$defs/refusal" }
  ]
}
