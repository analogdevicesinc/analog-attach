{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "init.schema.json",
  "title": "init response",
  "description": "Standard output of init in JSON mode (INIT-040): the workfile created or kept, or the refusal of INIT-019; where the backend is linux, also init --restore (INIT-104, INIT-106), and the project variables set with each starter written (INIT-107, INIT-110). Configuration errors (INIT-001) are a refusal too (common.schema.json#/$defs/config-refusal). $defs/base is InitResponse (overview 2.1).",
  "anyOf": [{ "$ref": "#/$defs/linux" }, { "$ref": "#/$defs/noos" }],
  "$defs": {
    "base": {
      "description": "InitResponse.",
      "allOf": [{ "$ref": "common.schema.json#/$defs/common" }],
      "required": ["path", "created"],
      "properties": {
        "path": { "type": "string", "pattern": "^/", "description": "The workfile, absolute." },
        "created": { "type": "boolean", "description": "true when init created the workfile (INIT-034), false when it kept the configured one." }
      }
    },
    "linux": {
      "oneOf": [{ "$ref": "#/$defs/linux-ready" }, { "$ref": "#/$defs/linux-restored" }, { "$ref": "common.schema.json#/$defs/refusal" }, { "$ref": "common.schema.json#/$defs/config-refusal" }]
    },
    "linux-ready": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "required": ["linux", "devicetree", "overlay"],
      "properties": {
        "ok": { "const": true },
        "message": { "type": "string", "pattern": "^Workspace ready: linux .+, devicetree .+, overlay .+ \\((created|kept)\\)$" },
        "severity": { "const": "info" },
        "linux": { "type": "string", "pattern": "^/", "description": "The Linux tree configured, absolute." },
        "devicetree": { "type": "string", "pattern": "^/", "description": "The base devicetree configured, absolute." },
        "overlay": { "type": "string", "pattern": "^/", "deprecated": true, "description": "The same as path, kept for one release." },
        "scripts": {
          "description": "The scripts at the project root, aa_build.sh then aa_deploy.sh (INIT-100): each written now (created) or kept. One that couldn't be written is left out, with a warning (INIT-102).",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "created", "variables"],
            "properties": {
              "path": { "type": "string", "pattern": "/aa_(build|deploy)\\.sh$" },
              "created": { "type": "boolean" },
              "variables": { "$ref": "#/$defs/variables-set" }
            },
            "additionalProperties": false
          },
          "maxItems": 2
        }
      },
      "unevaluatedProperties": false
    },
    "linux-restored": {
      "description": "init --restore <build|deploy>: that script's starter written (INIT-104, INIT-106).",
      "allOf": [{ "$ref": "common.schema.json#/$defs/common" }],
      "required": ["path", "created", "variables"],
      "properties": {
        "ok": { "const": true },
        "message": { "type": "string", "pattern": "^Wrote the starter aa_(build|deploy)\\.sh: /.+$" },
        "severity": { "const": "info" },
        "path": { "type": "string", "pattern": "^/.+/aa_(build|deploy)\\.sh$", "description": "The script, absolute." },
        "created": { "type": "boolean", "description": "false when it replaced a file." },
        "variables": { "$ref": "#/$defs/variables-set" }
      },
      "unevaluatedProperties": false
    },
    "variables-set": {
      "description": "The project variables the starter uses that were set now, with it (INIT-107, INIT-110), in the starter's order: a plain one with its value, a secret by its name alone (never a value, COM-157). Empty for a script kept (INIT-101), for aa_build.sh, whose starter uses none, and when the project had them already (INIT-108); one that couldn't be set is left out, with a warning (INIT-109).",
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["name", "secret", "value"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "secret": { "const": false },
              "value": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["name", "secret"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "secret": { "const": true }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "noos": {
      "anyOf": [
        {
          "description": "Where the backend is noos: the workfile init created (INIT-510). created is always true: an existing workfile is a refusal (INIT-502).",
          "allOf": [{ "$ref": "#/$defs/base" }],
          "properties": {
            "ok": { "const": true },
            "message": { "type": "string", "pattern": "^Created a workfile for (board .+ \\(platform .+\\)|platform .+)$" },
            "severity": { "const": "info" },
            "created": { "const": true }
          },
          "unevaluatedProperties": false
        },
        { "$ref": "common.schema.json#/$defs/refusal" }
      ]
    }
  }
}
