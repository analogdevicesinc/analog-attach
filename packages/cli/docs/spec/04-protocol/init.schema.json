{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "init.schema.json",
  "title": "init response",
  "description": "Standard output of init in JSON mode (INIT-040): the workfile created or kept, or the refusal of INIT-019. Configuration errors (INIT-001) go to standard error (config-error.schema.json). $defs/base is InitResponse (overview 2.1).",
  "anyOf": [{ "$ref": "#/$defs/linux" }, { "$ref": "#/$defs/noos" }],
  "$defs": {
    "base": {
      "description": "InitResponse.",
      "allOf": [{ "$ref": "common.schema.json#/$defs/common" }],
      "required": ["path", "created"],
      "properties": {
        "path": { "type": "string", "pattern": "^/", "description": "The workfile, absolute." },
        "created": { "type": "boolean", "description": "true when init created the workfile (INIT-034), false when it kept the configured one." }
      }
    },
    "linux": {
      "oneOf": [{ "$ref": "#/$defs/linux-ready" }, { "$ref": "common.schema.json#/$defs/refusal" }]
    },
    "linux-ready": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "required": ["linux", "devicetree", "overlay"],
      "properties": {
        "ok": { "const": true },
        "message": { "type": "string", "pattern": "^Workspace ready: linux .+, devicetree .+, overlay .+ \\((created|kept)\\)$" },
        "severity": { "const": "info" },
        "linux": { "type": "string", "pattern": "^/", "description": "The Linux tree configured, absolute." },
        "devicetree": { "type": "string", "pattern": "^/", "description": "The base devicetree configured, absolute." },
        "overlay": { "type": "string", "pattern": "^/", "deprecated": true, "description": "The same as path, kept for one release." }
      },
      "unevaluatedProperties": false
    },
    "noos": {
      "anyOf": [
        {
          "description": "Where the backend is noos: the workfile init created (INIT-510). created is always true: an existing workfile is a refusal (INIT-502).",
          "allOf": [{ "$ref": "#/$defs/base" }],
          "properties": {
            "ok": { "const": true },
            "message": { "type": "string", "pattern": "^Created a workfile for (board .+ \\(platform .+\\)|platform .+)$" },
            "severity": { "const": "info" },
            "created": { "const": true }
          },
          "unevaluatedProperties": false
        },
        { "$ref": "common.schema.json#/$defs/refusal" }
      ]
    }
  }
}
