# Auto-generated src.mk
# Do not edit manually

# Sources
{% for src in util_srcs %}
SRCS += $(NO-OS)/{{ src }}
{% endfor %}

{% for src in drivers_srcs %}
SRCS += $(DRIVERS)/{{ src }}
{% endfor %}

{% for src in platform_srcs %}
SRCS += $(PLATFORM_DRIVERS)/{{ src }}
{% endfor %}

{% for src in project_srcs %}
SRCS += $(PROJECT)/{{ src }}
{% endfor %}

# Includes
{% for inc in drivers_incs %}
INCS += $(DRIVERS)/{{ inc }}
{% endfor %}

{% for inc in include_incs %}
INCS += $(INCLUDE)/{{ inc }}
{% endfor %}

{% for inc in platform_incs %}
INCS += $(PLATFORM_DRIVERS)/{{ inc }}
{% endfor %}

{% for inc in project_incs %}
INCS += $(PROJECT)/{{ inc }}
{% endfor %}
