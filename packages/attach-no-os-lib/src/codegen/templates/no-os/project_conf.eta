<%
/*
 * project.conf - the project defconfig, and the replacement for src.mk.
 *
 * The no-OS CMake build compiles sources by Kconfig symbol rather than by file list,
 * so this file is the entire build description for the driver side of the project.
 * It is merged on top of the board defconfig (board_configs/<vendor>/<board>_defconfig)
 * by generate_config.py, which then produces no_os_config.h.
 *
 * Only symbols this workfile OWNS are listed. Kconfig closes the rest: `select` is
 * transitive and forward-propagating, so CONFIG_GPIO arrives on its own wherever a
 * driver selects it. `depends on` is NOT closed - it is a constraint that Kconfig
 * never satisfies for you - which is why a ruleset names its parent menu symbol
 * (CONFIG_ACCEL) alongside its leaf (CONFIG_ACCEL_ADXL355). Without the parent, the
 * leaf is silently capped at n and the driver disappears from the build, surfacing
 * much later as a link error.
 *
 * NOTE: apostrophes break the Eta parser even inside comments, so this file uses only
 * block comments and apostrophe-free prose.
 */
const H = include("./_helpers", { h: it.h });
const symbols = H.collect_config_symbols(it.workfile);
-%>
# <%= it.project_name %>
# Generated by attach-no-os - do not edit manually.
#
# Kconfig symbols required by this workfile. Platform driver symbols
# (CONFIG_SPI_MAXIM and friends) are not here: they come from the
# <%= it.board.board_config_file %> board defconfig.
<% for (const symbol of symbols) { -%>
CONFIG_<%= symbol %>=y
<% } -%>
