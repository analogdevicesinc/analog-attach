<%
/*
 * The project CMakeLists.txt, written to work unchanged in both build contexts:
 *
 *   in-tree     <no-OS>/projects/<name>/  - projects/CMakeLists.txt add_subdirectory()s
 *                                           us, so the root has already run project()
 *                                           and include(project_utils).
 *   out-of-tree anywhere                  - we are the top-level CMakeLists and have to
 *                                           set up the toolchain and pull no-OS in.
 *
 * The guard below is what distinguishes them, and it is the same test the no-OS root
 * uses for its own NATIVE_BUILD.
 *
 * NOTE: apostrophes break the Eta parser even inside comments, so this file uses only
 * block comments and apostrophe-free prose.
 */
const wf = it.workfile;

/*
 * Source and header files come from project_structure.json, the same manifest that
 * decides which templates get rendered. Reading it here rather than listing
 * src/main.c and friends inline means adding a file to the project is a one-line
 * manifest change and cannot leave CMake out of step with what codegen writes.
 */
const sources = it.files.map(f => f.output).filter(o => o.endsWith(".c"));

/*
 * Every directory that holds a generated header, plus src/ unconditionally - the
 * templates include common_data.h and user_app.h by basename, so both of their
 * directories have to be on the include path even if the manifest ever stops
 * producing a header in one of them.
 */
const include_dirs = [...new Set([
	"src",
	...it.files
		.map(f => f.output)
		.filter(o => o.endsWith(".h"))
		.map(o => o.slice(0, o.lastIndexOf("/")))
		.filter(d => d.length > 0),
])];
-%>
# <%= it.project_name %>
# Generated by attach-no-os - do not edit manually.
#
# Builds both standalone and from inside <no-OS>/projects/<%= it.project_name %>/.

if(CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
    # Standalone build. Presets need 3.28; the no-OS root itself asks for 3.27.
    cmake_minimum_required(VERSION 3.28)

    set(NO_OS_PATH "<%= it.noos_path %>" CACHE PATH "Path to the no-OS repository")

    # Set the toolchain ourselves, before project(), for two reasons: CMake only
    # honours it before the first project() call, and the no-OS root would otherwise
    # compose ${CMAKE_SOURCE_DIR}/${NO_OS_TOOLCHAIN_PATH} from a path that is already
    # absolute in the add_subdirectory context. Both of its sites are guarded by
    # `if(NOT CMAKE_TOOLCHAIN_FILE)`, so setting it here is what makes an
    # out-of-tree build work at all.
    if(NOT CMAKE_TOOLCHAIN_FILE)
        set(CMAKE_TOOLCHAIN_FILE "${NO_OS_PATH}/drivers/platform/${PLATFORM}/toolchain.cmake")
    endif()

    project(<%= it.project_name %> VERSION 1.0 LANGUAGES C CXX ASM)

    # no-OS appends cmake/ and cmake/stm32/ and cmake/libraries/ to CMAKE_MODULE_PATH
    # itself; repeat it here so include(project_utils) below resolves in this scope.
    list(APPEND CMAKE_MODULE_PATH
        "${NO_OS_PATH}/cmake"
        "${NO_OS_PATH}/cmake/stm32"
        "${NO_OS_PATH}/cmake/libraries"
    )

    # Defines the `no-os` library target and generates no_os_config.h from
    # project.conf plus the board defconfig. NATIVE_BUILD is false here, so it does
    # not descend into its own projects/ directory.
    add_subdirectory("${NO_OS_PATH}" "${CMAKE_BINARY_DIR}/no-os-core-build")

    include(project_utils)
endif()

# The target name must equal the project directory name: no_os_build.py and
# projects/CMakeLists.txt both derive one from the other.
add_executable(<%= it.project_name %>)

target_sources(<%= it.project_name %> PRIVATE
<% for (const source of sources) { -%>
    ${CMAKE_CURRENT_SOURCE_DIR}/<%= source %>
<% } -%>
)

target_include_directories(<%= it.project_name %> PUBLIC
<% for (const directory of include_dirs) { -%>
    ${CMAKE_CURRENT_SOURCE_DIR}/<%= directory %>
<% } -%>
)

target_link_libraries(<%= it.project_name %> no-os)

# From no-OS cmake/project_utils.cmake and cmake/FlashTools.cmake. Mandatory:
# config_platform_sdk wires in the vendor SDK (the link fails without it on every
# platform whose SDK does not come from the toolchain file), add_flash_target adds
# the flash target, and post_build_config produces the .hex/.bin and debug configs.
config_platform_sdk(<%= it.project_name %>)
add_flash_target(<%= it.project_name %>)
post_build_config(<%= it.project_name %>)
