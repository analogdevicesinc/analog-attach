<%
/*
 * Shared CAPI assembly helpers for the project templates.
 *
 * This whole file is one JS block that ends in `return { ... }`. Eta include() hands
 * back whatever a template produces, so returning an object gives callers the
 * functions. A partial does NOT inherit the parent `it`, so consumers pass it in:
 * `<% const H = include("./_helpers", { h: it.h }) %>`.
 *
 * Only cross-template logic lives here: which struct fields are static and which are
 * patched at runtime (a reference to a handle only exists once that handle is inited),
 * agreed on by common_data.c/.h and main.c. The build facts come from it.h.capi_project.
 *
 * NOTE: apostrophes break the Eta parser even inside comments, so this file uses only
 * block comments and apostrophe-free prose.
 */

/*
 * The symbol a patch READS, which is what decides where the patch may be emitted (see
 * patch_schedule.ts). A reference value is either `node` or `node.member`, and either way
 * the value is only live once `node` has been initialized.
 */
function patch_source(value) {
	return String(value).split(".")[0];
}

/*
 * One struct: split its properties into handle references (patched at runtime, once the
 * handle is inited) and static fields (emitted in the initializer).
 */
function build_struct_view(name, ruleset, wf) {
	const runtime_assignments = [];
	const fields = [];

	for (const property of ruleset.properties) {
		/*
		 * A readonly field is filled in by generated code, so it is neither a static field
		 * nor a patch. Skipped before the checks below because an unset readonly pointer
		 * would otherwise print as `.field = NULL` and then be assigned anyway.
		 */
		if (property.readonly === true) {
			continue;
		}

		if (it.h.is_descriptor_reference(property, wf) && it.h.effective_value(property) !== undefined) {
			runtime_assignments.push({
				struct_name: name,
				field_path: property.name,
				value: it.h.reference_expression(property, wf),
				source: patch_source(it.h.effective_value(property)),
			});
		} else if (it.h.effective_value(property) !== undefined || it.h.is_null_pointer(property)) {
			fields.push(property);
		}
	}

	return {
		type: ruleset.$symbol,
		name: name,
		is_const: runtime_assignments.length === 0,
		fields: fields,
		runtime_assignments: runtime_assignments,
	};
}

/*
 * Struct nodes embedded in another: named by a non-pointer include (a plain one, a union
 * member, an array element), so the C member IS that struct, not a pointer to it. Such a
 * node has no global of its own. Its fields are written inside the owner initializer, as
 * in `.device = { .i2c_dev = &capi_i2c_device }`, because a static initializer cannot copy
 * another object. Maps each embedded node to its owner and the C path from the owner to it.
 */
function embedded_nodes(wf) {
	const embedded = new Map();
	const is_struct_node = value => typeof value === "string" && wf.symbols[value]?._t === "RulesetStruct";
	for (const [owner, ruleset] of Object.entries(wf.symbols)) {
		if (ruleset._t !== "RulesetStruct") {
			continue;
		}
		for (const property of ruleset.properties) {
			const value = it.h.effective_value(property);
			if (property._t === "IncludeProperty" && property.pointer !== true && is_struct_node(value)) {
				embedded.set(value, { owner, path: property.name });
			} else if (property._t === "UnionProperty" && value !== undefined && value !== null) {
				for (const [member_name, target] of Object.entries(value)) {
					const member = property.members.find(candidate => candidate.name === member_name);
					if (member !== undefined && member.pointer !== true && is_struct_node(target)) {
						embedded.set(target, { owner, path: `${property.name}.${member_name}` });
					}
				}
			} else if (property._t === "ArrayProperty" && property.element._t === "IncludeProperty"
				&& property.element.pointer !== true && Array.isArray(value)) {
				value.forEach((element, index) => {
					if (is_struct_node(element)) {
						embedded.set(element, { owner, path: `${property.name}[${index}]` });
					}
				});
			}
		}
	}
	return embedded;
}

/* The global an embedded node lives in, and the C path to it: ad7156_init_param is ad7156_capi_init_param.device. */
function embedding_root(name, embedded) {
	let root = name;
	let path = "";
	const seen = new Set();
	for (let at = embedded.get(root); at !== undefined; at = embedded.get(root)) {
		if (seen.has(root)) {
			throw new Error(`Struct ${name} is embedded in itself, through ${[...seen].join(", ")}`);
		}
		seen.add(root);
		path = path === "" ? at.path : `${at.path}.${path}`;
		root = at.owner;
	}
	return { root, path };
}

/*
 * Every struct node with a global of its own. None is const: CAPI init functions take their
 * config non-const, and a driver init_param goes in through `void *extra`, so a const one
 * would not even compile there without a cast. An embedded node is not one of them, but its
 * runtime assignments are, written through the global it lives in.
 */
function struct_views(wf) {
	const embedded = embedded_nodes(wf);
	const views = new Map();
	const nested_assignments = [];
	for (const [name, ruleset] of Object.entries(wf.symbols)) {
		/* An eval board is hardware on the bench, not a C struct. */
		if (ruleset._t !== "RulesetStruct" || ruleset.$eval_board === true) {
			continue;
		}
		const view = build_struct_view(name, ruleset, wf);
		if (!embedded.has(name)) {
			views.set(name, { ...view, is_const: false });
			continue;
		}
		const { root, path } = embedding_root(name, embedded);
		for (const assignment of view.runtime_assignments) {
			nested_assignments.push({ root, assignment: { ...assignment, struct_name: root, field_path: `${path}.${assignment.field_path}` } });
		}
	}
	for (const { root, assignment } of nested_assignments) {
		views.get(root)?.runtime_assignments.push(assignment);
	}
	return [...views.values()];
}

/* The view of one embedded node, for its owner initializer to write inline. */
function embedded_view(name, wf) {
	return build_struct_view(name, wf.symbols[name], wf);
}

return {
	struct_views: struct_views,
	embedded_nodes: embedded_nodes,
	embedded_view: embedded_view,
};
%>
