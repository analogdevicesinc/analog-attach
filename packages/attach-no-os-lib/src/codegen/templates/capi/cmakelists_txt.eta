<%
/*
 * CMakeLists.txt for a CAPI application, laid out like the capi-noos reference apps
 * (projects/eval-adxl355-pmdz/basic). The platform, its board and every dependency are
 * resolved by the capi SDK from module.yml and the preset; this file only names the
 * sources, the board BSP and the libraries to link.
 *
 * NOTE: apostrophes break the Eta parser even inside comments.
 */
const project = it.h.capi_project(it.workfile);
/*
 * The app target is suffixed so it can never clash with a library target: a project named
 * after its part (adxl355) would otherwise collide with capi-noos own adxl355 driver target.
 */
const target = `${it.project_name.replace(/[^A-Za-z0-9_]/g, "_")}_app`;
/* capi-noos -> CAPI_NOOS_DIR: the variable the SDK resolves a dependency into. */
const dir_of = name => `CAPI_${name.replace(/^capi-/, "").toUpperCase().replace(/-/g, "_")}_DIR`;
const collections = project.collections;
const sources = it.files.filter(f => f.output.endsWith(".c")).map(f => f.output);
const includes = [...new Set(it.files.filter(f => f.output.endsWith(".h")).map(f => f.output.split("/").slice(0, -1).join("/")))];
-%>
# <%= it.project_name %>
# Generated by analog-attach - do not edit manually.

cmake_minimum_required(VERSION 3.27)

if(NOT DEFINED CAPI_DIR)
    if(DEFINED ENV{CAPI_DIR})
        set(CAPI_DIR "$ENV{CAPI_DIR}")
    else()
        message(FATAL_ERROR "CAPI_DIR not set. Export CAPI_DIR=/path/to/capi or pass -DCAPI_DIR=...")
    endif()
endif()

include("${CAPI_DIR}/sdk/cmake/capi_create_application.cmake")

# Sets CMAKE_TOOLCHAIN_FILE from the preset platform, so it runs before project().
capi_resolve_platform()
project(<%= target %> LANGUAGES C ASM)

<% for (const c of collections) { -%>
list(APPEND CAPI_KCONFIG_SOURCES "${<%= dir_of(c.name) %>}/Kconfig")
set(ENV{<%= dir_of(c.name) %>} "${<%= dir_of(c.name) %>}")
<% } -%>

# NO_BOARD_BSP: the app declares the board peripherals it uses itself (src/bsp), so only
# the board BSP sources are added, not its header.
capi_create_application(<%= target %> NO_BOARD_BSP SOURCES
<% for (const s of sources) { -%>
    <%= s %>
<% } -%>
)

target_include_directories(<%= target %> PRIVATE
<% for (const i of includes) { -%>
    <%= i %>
<% } -%>
)

target_sources(<%= target %> PRIVATE
    ${CAPI_${_capi_app_platform_upper}_BOARD_BSP_SRC})

<% for (const c of collections) { -%>
add_subdirectory("${<%= dir_of(c.name) %>}" "${CMAKE_BINARY_DIR}/<%= c.name %>")
<% } -%>
target_link_libraries(<%= target %> PUBLIC
<% for (const d of project.drivers) { -%>
    <%= d.link %>
<% } -%>
<% for (const p of project.packages) { -%>
    <%= p %>
<% } -%>
)
