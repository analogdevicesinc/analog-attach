<%
/*
 * main.c: bring the platform up, then every handle, in an order where each one comes
 * after the handles it reaches. A struct field that names a handle only has a value once
 * that handle is inited, so it is patched right after it (see patch_schedule.ts).
 *
 * The app only brings the hardware up; what it then does is the user code at the end.
 *
 * NOTE: apostrophes break the Eta parser even inside comments, so this file uses only
 * block comments and apostrophe-free prose.
 */
const H = include("./_helpers", { h: it.h });
const project = it.h.capi_project(it.workfile);
const runtime_assignments = H.struct_views(it.workfile).flatMap(view => view.runtime_assignments);
const devices = it.h.devices(it.workfile);
const patches = it.h.schedule_patches(runtime_assignments, devices.map(d => d.descriptor_name));
-%>
#include "common_data.h"

int main(void)
{
	int ret;

	capi_platform_init();
<% if (project.console) { -%>

	ret = capi_uart_init(&console_uart, &<%= project.console.symbol %>);
	if (ret)
		return ret;
	capi_stdio_init(console_uart);
<% } -%>
<% for (const a of patches.before) { -%>
	<%= a.struct_name %>.<%= a.field_path %> = <%= a.value %>;
<% } -%>
<% for (const d of devices) { -%>

<% if (d.init_code) { -%>
<%= it.h.tab_indent(d.init_code) %>
<% } else { -%>
	ret = <%= d.init_function %>(&<%= d.descriptor_name %>, &<%= d.symbol_name %>);
	if (ret)
		return ret;
<% } -%>
<% for (const a of patches.after.get(d.descriptor_name) ?? []) { -%>
	<%= a.struct_name %>.<%= a.field_path %> = <%= a.value %>;
<% } -%>
<% } -%>

	/* Everything is up. Your application code goes here. */

	return 0;
}
