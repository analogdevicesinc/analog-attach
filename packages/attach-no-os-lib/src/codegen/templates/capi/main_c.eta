<%
/*
 * main.c: bring the platform up, then every handle (see _bringup.eta), then hand over to
 * either the parts examples or the user app_main(), as the `example` setting says.
 *
 * The examples are each driver `example:` (see example_blocks in codegen_helpers.ts),
 * regenerated on every generate so they follow the devices in the workfile: each setup
 * once, then every loop over and over. The user code lives in src/app.c, which generate
 * writes only when it does not exist yet.
 *
 * NOTE: apostrophes break the Eta parser even inside comments, so this file uses only
 * block comments and apostrophe-free prose.
 */
const project = it.h.capi_project(it.workfile);
const examples = it.example && project.console ? it.h.example_blocks(it.workfile) : [];
/* The handle, and its driver when the name does not already say it (capi_adc_chan). */
const label = e => (e.handle === e.driver ? e.handle : `${e.handle} (${e.driver})`);
-%>
#include "common_data.h"
<% if (examples.length > 0) { -%>
#include "capi_time.h"
#include <stdio.h>
<% } -%>

/* Your application, in src/app.c: generate never overwrites that file. */
int app_main(void);
<% if (examples.length > 0) { -%>

/*
 * The examples of the parts in the workfile: each reads its part and prints what it got
 * on the console. Regenerated by attach-noos generate, so do not edit it: write your own
 * code in app_main() instead, in new files and functions of your own, and run it with
 * attach-noos tool-config-set example false.
 */
static int example_main(void)
{
	int ret;
<% for (const e of examples.filter(e => e.setup !== undefined)) { -%>

	/* <%= label(e) %> */
	{
<%= it.h.tab_indent(e.setup, 2) %>
	}
<% } -%>

	while (1) {
<% for (const e of examples.filter(e => e.loop !== "")) { -%>
		/* <%= label(e) %> */
		{
<%= it.h.tab_indent(e.loop, 3) %>
		}
<% } -%>
		capi_wait_ms(500);
	}
}
<% } -%>

int main(void)
{
	int ret;

<%~ include("./_bringup", { h: it.h, workfile: it.workfile }) -%>

<% if (examples.length > 0) { -%>
	/* Everything is up: the examples run now. Your own code goes in app_main(). */
	return example_main();
<% } else { -%>
	/* Everything is up. Your code goes in app_main(), in src/app.c. */
	return app_main();
<% } -%>
}
