<%
/*
 * module.yml: what the capi SDK resolves the build from - the sources, the board this
 * app has a preset for, and the modules it depends on, where they are checked out here.
 *
 * NOTE: apostrophes break the Eta parser even inside comments.
 */
const project = it.h.capi_project(it.workfile);
const sources = it.files.filter(f => f.output.endsWith(".c")).map(f => f.output);
const includes = [...new Set(it.files.filter(f => f.output.endsWith(".h")).map(f => f.output.split("/").slice(0, -1).join("/")))];
-%>
# Generated by analog-attach - do not edit manually.
name: <%= it.project_name %>
type: application
version: "1.0.0"
description: "Generated by analog-attach for <%= project.board.name %>"

requires_capi: ">=1.0.0"

build:
  sources:
<% for (const s of sources) { -%>
    - <%= s %>
<% } -%>
  includes:
<% for (const i of includes) { -%>
    - <%= i %>
<% } -%>

boards:
  - <%= project.board.name %>

depends:
<% for (const d of project.dependencies) { -%>
  - name: <%= d.name %>
    version: ">=1.0.0"
    env_override: <%= d.env_override %>
    default_local: "<%= d.path %>"
<% } -%>
