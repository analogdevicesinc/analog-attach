<%
/*
 * common_data.h: the headers the generated C needs, the board peripherals (through
 * parameters.h), and a declaration for every struct and handle common_data.c defines.
 *
 * NOTE: apostrophes break the Eta parser even inside comments.
 */
const H = include("./_helpers", { h: it.h });
const wf = it.workfile;
const project = it.h.capi_project(wf);
const structs = H.struct_views(wf);
const devices = it.h.devices(wf);
-%>
#ifndef COMMON_DATA_H
#define COMMON_DATA_H

<% for (const header of project.headers) { -%>
#include "<%= header %>"
<% } -%>
#include "parameters.h"

<% if (project.console) { -%>
/* The UART stdio runs on, brought up first in main.c. */
extern struct capi_uart_handle *console_uart;

<% } -%>
/* Handles, filled in by their init functions in main.c. */
<% for (const d of devices) { -%>
extern struct <%= d.handle_type %> *<%= d.descriptor_name %>;
<% } -%>

<% for (const s of structs) { -%>
extern <%= s.is_const ? "const " : "" %>struct <%= s.type %> <%= s.name %>;
<% } -%>

#endif /* COMMON_DATA_H */
